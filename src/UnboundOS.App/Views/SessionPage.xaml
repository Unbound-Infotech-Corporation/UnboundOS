<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="UnboundOS.App.Views.SessionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:UnboundOS.Core.Models"
    Background="Transparent">

    <ScrollViewer Padding="8">
        <StackPanel Spacing="20" MaxWidth="1100">
            <StackPanel Spacing="6">
                <TextBlock Style="{StaticResource SectionTitleText}" Text="{x:Bind ViewModel.Headline, Mode=OneWay}" />
                <TextBlock Style="{StaticResource BodyMutedText}" Text="{x:Bind ViewModel.Detail, Mode=OneWay}" />
            </StackPanel>

            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.1*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource PanelBorderStyle}" Grid.Column="0">
                    <StackPanel Spacing="14">
                        <TextBlock FontFamily="Bahnschrift" FontSize="16" Foreground="{StaticResource SignalLimeBrush}" Text="PROFILE" />
                        <ComboBox
                            ItemsSource="{x:Bind ViewModel.Profiles, Mode=OneWay}"
                            SelectedItem="{x:Bind ViewModel.SelectedProfile, Mode=TwoWay}"
                            HorizontalAlignment="Stretch">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="models:SessionProfile">
                                    <StackPanel>
                                        <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" />
                                        <TextBlock Text="{x:Bind Description}" Opacity="0.7" TextWrapping="Wrap" FontSize="12" />
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button
                                Style="{StaticResource SignalButtonStyle}"
                                Content="ENTER SESSION"
                                Command="{x:Bind ViewModel.EnterSessionCommand}"
                                IsEnabled="{x:Bind ViewModel.CanEnter, Mode=OneWay}" />
                            <Button
                                Style="{StaticResource GhostButtonStyle}"
                                Content="EXIT / RESTORE"
                                Command="{x:Bind ViewModel.ExitSessionCommand}"
                                IsEnabled="{x:Bind ViewModel.CanExit, Mode=OneWay}" />
                            <Button
                                Style="{StaticResource GhostButtonStyle}"
                                Content="SCAN"
                                Command="{x:Bind ViewModel.RefreshSuspectsCommand}" />
                        </StackPanel>

                        <TextBlock Style="{StaticResource BodyMutedText}" Text="Enter Session switches the Windows power plan and NIC metrics (UAC may prompt). Critical processes stay protected." />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource PanelBorderStyle}" Grid.Column="1">
                    <StackPanel Spacing="10">
                        <TextBlock FontFamily="Bahnschrift" FontSize="16" Foreground="{StaticResource IceTelemetryBrush}" Text="LIVE DENYLIST HITS" />
                        <ListView ItemsSource="{x:Bind ViewModel.RunningSuspects, Mode=OneWay}" MinHeight="120" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource PanelBorderStyle}">
                <StackPanel Spacing="8">
                    <TextBlock FontFamily="Bahnschrift" FontSize="16" Foreground="{StaticResource WarmPaperBrush}" Text="SESSION LOG" />
                    <ItemsControl ItemsSource="{x:Bind ViewModel.ActionLog, Mode=OneWay}" FontFamily="Cascadia Mono" FontSize="12" Foreground="{StaticResource MutedSteelBrush}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
