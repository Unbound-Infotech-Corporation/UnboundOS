<Page
    x:Class="UnboundOS.App.Views.SessionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:UnboundOS.Core.Models"
    Background="Transparent">

    <ScrollViewer Style="{StaticResource ConsolePageScrollStyle}" AutomationProperties.Name="Session engine">
        <StackPanel Spacing="22">
            <StackPanel Spacing="6">
                <TextBlock Style="{StaticResource KickerText}" Text="SESSION ENGINE" />
                <TextBlock Style="{StaticResource SectionTitleText}" Text="{x:Bind ViewModel.Headline, Mode=OneWay}" />
                <TextBlock
                    Style="{StaticResource BodyMutedText}"
                    MaxWidth="820"
                    Text="{x:Bind ViewModel.Detail, Mode=OneWay}" />
            </StackPanel>

            <TextBlock Style="{StaticResource TileRowLabelText}" Text="PROFILES" />
            <ListView
                Height="320"
                ItemsSource="{x:Bind ViewModel.Profiles, Mode=OneWay}"
                SelectedItem="{x:Bind ViewModel.SelectedProfile, Mode=TwoWay}"
                SelectionMode="Single"
                Style="{StaticResource ConsoleListViewStyle}"
                ItemContainerStyle="{StaticResource ConsoleTileItemStyle}"
                AutomationProperties.Name="Session profile">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:SessionProfile">
                        <Border Style="{StaticResource ConsoleTileCardStyle}">
                            <Grid>
                                <Border Style="{StaticResource ConsoleTileArtStyle}" />
                                <TextBlock Style="{StaticResource TileMonogramText}" Text="{x:Bind Monogram}" />
                                <StackPanel VerticalAlignment="Bottom" Padding="18,14">
                                    <TextBlock Style="{StaticResource TileCaptionText}" Text="{x:Bind Name}" />
                                    <TextBlock Style="{StaticResource TileMetaText}" Text="{x:Bind KindLabel}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <TextBlock
                Style="{StaticResource BodyMutedText}"
                MaxWidth="820"
                Text="{x:Bind ViewModel.SelectedProfile.Description, Mode=OneWay}" />

            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button
                    Style="{StaticResource SignalButtonStyle}"
                    Content="ENTER SESSION"
                    Command="{x:Bind ViewModel.EnterSessionCommand}"
                    IsEnabled="{x:Bind ViewModel.CanEnter, Mode=OneWay}"
                    AutomationProperties.Name="Enter session" />
                <Button
                    Style="{StaticResource GhostButtonStyle}"
                    Content="EXIT / RESTORE"
                    Command="{x:Bind ViewModel.ExitSessionCommand}"
                    IsEnabled="{x:Bind ViewModel.CanExit, Mode=OneWay}"
                    AutomationProperties.Name="Exit session and restore desktop" />
                <Button
                    Style="{StaticResource GhostButtonStyle}"
                    Content="SCAN"
                    Command="{x:Bind ViewModel.RefreshSuspectsCommand}"
                    AutomationProperties.Name="Scan denylist suspects" />
            </StackPanel>

            <TextBlock
                Style="{StaticResource BodyMutedText}"
                Text="Enter Session switches the Windows power plan, applies reversible Game Mode / Game DVR / visual-effects posture, and NIC metrics (UAC may prompt). Exit / Restore puts the desktop back. Explorer stays. Defender is not disabled. UnboundOS never lowers the monitor. Play native." />

            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="1.1*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource PanelBorderStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Style="{StaticResource PanelLabelText}" Text="LIVE DENYLIST HITS" />
                        <ListView
                            ItemsSource="{x:Bind ViewModel.RunningSuspects, Mode=OneWay}"
                            MinHeight="120"
                            Style="{StaticResource SuperCleanListViewStyle}"
                            ItemContainerStyle="{StaticResource SuperCleanListItemStyle}"
                            AutomationProperties.Name="Running denylist processes" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource PanelBorderStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Style="{StaticResource PanelLabelText}" Foreground="{StaticResource PaperBrush}" Text="SESSION LOG" />
                        <ItemsControl
                            ItemsSource="{x:Bind ViewModel.ActionLog, Mode=OneWay}"
                            FontFamily="{StaticResource MonoFontFamily}"
                            FontSize="12"
                            Foreground="{StaticResource MutedTextBrush}" />
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
