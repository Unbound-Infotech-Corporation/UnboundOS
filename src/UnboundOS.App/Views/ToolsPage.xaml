<Page
    x:Class="UnboundOS.App.Views.ToolsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:UnboundOS.Core.Models"
    xmlns:views="using:UnboundOS.App.Views"
    Background="Transparent">

    <ScrollViewer Style="{StaticResource ConsolePageScrollStyle}" AutomationProperties.Name="Tools marketplace">
        <StackPanel Spacing="22">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="6">
                    <TextBlock Style="{StaticResource KickerText}" Text="LOCAL KIT" />
                    <TextBlock Style="{StaticResource SectionTitleText}" Text="Tools" />
                    <TextBlock
                        Style="{StaticResource BodyMutedText}"
                        MaxWidth="820"
                        Text="A living-room row of capture, launchers, and chat. Select a tile. Open launches the real app. Get opens the official download page — UnboundOS never ships an installer." />
                </StackPanel>
                <Button
                    Grid.Column="1"
                    VerticalAlignment="Top"
                    Style="{StaticResource GhostButtonStyle}"
                    Content="REFRESH KIT"
                    Command="{x:Bind ViewModel.RefreshCommand}"
                    AutomationProperties.Name="Refresh local tool catalog" />
            </Grid>

            <TextBlock Style="{StaticResource TileRowLabelText}" Text="KIT" />
            <ListView
                Height="320"
                ItemsSource="{x:Bind ViewModel.KitTools, Mode=OneWay}"
                SelectedItem="{x:Bind ViewModel.SelectedKitTool, Mode=OneWay}"
                IsItemClickEnabled="True"
                ItemClick="Kit_ItemClick"
                SelectionMode="Single"
                Style="{StaticResource ConsoleListViewStyle}"
                ItemContainerStyle="{StaticResource ConsoleTileItemStyle}"
                AutomationProperties.Name="Game and stream tools">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:DesktopTool">
                        <Border Style="{StaticResource ConsoleTileCardStyle}">
                            <Grid>
                                <Border Style="{StaticResource ConsoleTileArtStyle}" />
                                <TextBlock Style="{StaticResource TileMonogramText}" Text="{x:Bind Monogram}" />
                                <StackPanel VerticalAlignment="Bottom" Padding="18,14">
                                    <TextBlock Style="{StaticResource TileCaptionText}" Text="{x:Bind DisplayName}" />
                                    <TextBlock Style="{StaticResource TileMetaText}" Text="{x:Bind StatusLabel}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <TextBlock Style="{StaticResource TileRowLabelText}" Text="UTILITIES" />
            <ListView
                Height="260"
                ItemsSource="{x:Bind ViewModel.UtilityTools, Mode=OneWay}"
                SelectedItem="{x:Bind ViewModel.SelectedUtilityTool, Mode=OneWay}"
                IsItemClickEnabled="True"
                ItemClick="Utility_ItemClick"
                SelectionMode="Single"
                Style="{StaticResource ConsoleListViewStyle}"
                ItemContainerStyle="{StaticResource CompactConsoleTileItemStyle}"
                AutomationProperties.Name="Utility apps">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:DesktopTool">
                        <Border Style="{StaticResource ConsoleTileCardStyle}" Background="{StaticResource TileFieldAltBrush}">
                            <Grid>
                                <Border Style="{StaticResource ConsoleTileArtAltStyle}" />
                                <TextBlock Style="{StaticResource TileMonogramText}" FontSize="40" Text="{x:Bind Monogram}" />
                                <StackPanel VerticalAlignment="Bottom" Padding="16,12">
                                    <TextBlock Style="{StaticResource TileCaptionText}" FontSize="18" Text="{x:Bind DisplayName}" />
                                    <TextBlock Style="{StaticResource TileMetaText}" Text="{x:Bind StatusLabel}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <Border Style="{StaticResource PanelBorderStyle}">
                <StackPanel Spacing="12">
                    <TextBlock
                        Style="{StaticResource SectionTitleText}"
                        FontSize="28"
                        Text="{x:Bind ViewModel.SelectedName, Mode=OneWay}" />
                    <TextBlock
                        Style="{StaticResource BodyMutedText}"
                        Text="{x:Bind ViewModel.SelectedJob, Mode=OneWay}" />
                    <TextBlock
                        FontFamily="{StaticResource MonoFontFamily}"
                        FontSize="13"
                        Foreground="{StaticResource CyanPulseBrush}"
                        Text="{x:Bind ViewModel.AvailabilityLabel, Mode=OneWay}" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button
                            Style="{StaticResource SignalButtonStyle}"
                            Content="OPEN"
                            Command="{x:Bind ViewModel.LaunchCommand}"
                            IsEnabled="{x:Bind ViewModel.CanLaunch, Mode=OneWay}"
                            AutomationProperties.Name="Launch selected tool"
                            AutomationProperties.HelpText="Starts the installed application. UnboundOS does not inject into it." />
                        <Button
                            Style="{StaticResource GhostButtonStyle}"
                            Content="GET"
                            Command="{x:Bind ViewModel.GetCommand}"
                            IsEnabled="{x:Bind ViewModel.CanGet, Mode=OneWay}"
                            AutomationProperties.Name="Open official download page"
                            AutomationProperties.HelpText="Opens the official site or store URI. UnboundOS does not download the installer." />
                        <ProgressRing
                            Width="22"
                            Height="22"
                            IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                            AutomationProperties.Name="Tool scan in progress" />
                    </StackPanel>
                    <TextBlock
                        Style="{StaticResource BodyMutedText}"
                        Text="{x:Bind ViewModel.Status, Mode=OneWay}"
                        AutomationProperties.LiveSetting="Polite" />
                </StackPanel>
            </Border>

            <InfoBar
                IsOpen="{x:Bind ViewModel.ShowObsNeedsInstall, Mode=OneWay}"
                IsClosable="False"
                Severity="Warning"
                Title="OBS not installed"
                Message="This crop recipe needs OBS Studio. Use Get, then paste the filters. Play native — never lower monitor resolution." />

            <views:ObsCropRecipeView Visibility="{x:Bind ViewModel.ShowObsRecipe, Mode=OneWay}" />
        </StackPanel>
    </ScrollViewer>
</Page>
