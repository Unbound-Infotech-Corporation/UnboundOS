<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="UnboundOS.App.Views.ToolsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:UnboundOS.Core.Models"
    xmlns:views="using:UnboundOS.App.Views"
    Background="Transparent">

    <ScrollViewer Padding="8" AutomationProperties.Name="Tools marketplace">
        <StackPanel MaxWidth="1180" Spacing="18">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="5">
                    <TextBlock Style="{StaticResource KickerText}" Text="LOCAL KIT" />
                    <TextBlock Style="{StaticResource SectionTitleText}" Text="Tools" />
                    <TextBlock
                        Style="{StaticResource BodyMutedText}"
                        Text="Discover the apps you already use, launch them, or open an official Get page. UnboundOS is not a store and does not bundle installers." />
                </StackPanel>
                <Button
                    Grid.Column="1"
                    Style="{StaticResource GhostButtonStyle}"
                    Content="REFRESH KIT"
                    Command="{x:Bind ViewModel.RefreshCommand}"
                    AutomationProperties.Name="Refresh local tool catalog" />
            </Grid>

            <InfoBar
                IsOpen="True"
                IsClosable="False"
                Severity="Informational"
                Title="{x:Bind ViewModel.AvailabilityLabel, Mode=OneWay}"
                Message="{x:Bind ViewModel.SelectedJob, Mode=OneWay}" />

            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="330" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource PanelBorderStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock Style="{StaticResource PanelLabelText}" Text="KIT" />
                        <ListView
                            MinHeight="280"
                            ItemsSource="{x:Bind ViewModel.Tools, Mode=OneWay}"
                            SelectedItem="{x:Bind ViewModel.SelectedTool, Mode=TwoWay}"
                            SelectionMode="Single"
                            IsItemClickEnabled="True"
                            XYFocusKeyboardNavigation="Enabled"
                            AutomationProperties.Name="Desktop tools">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:DesktopTool">
                                    <StackPanel Margin="0,7" Spacing="3">
                                        <TextBlock
                                            FontSize="17"
                                            FontFamily="{StaticResource UiFontSemiboldFamily}"
                                            Foreground="{StaticResource PaperBrush}"
                                            Text="{x:Bind DisplayName}" />
                                        <TextBlock
                                            FontFamily="{StaticResource MonoFontFamily}"
                                            FontSize="11"
                                            Foreground="{StaticResource CyanPulseBrush}"
                                            Text="{x:Bind AvailabilityLabel}" />
                                        <TextBlock
                                            FontFamily="{StaticResource UiFontFamily}"
                                            FontSize="12"
                                            Foreground="{StaticResource MutedTextBrush}"
                                            Text="{x:Bind Job}"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <Button
                            Style="{StaticResource SignalButtonStyle}"
                            Content="LAUNCH"
                            Command="{x:Bind ViewModel.LaunchCommand}"
                            IsEnabled="{x:Bind ViewModel.CanLaunch, Mode=OneWay}"
                            AutomationProperties.Name="Launch selected tool"
                            AutomationProperties.HelpText="Starts the installed application. UnboundOS does not inject into it." />
                        <Button
                            Style="{StaticResource GhostButtonStyle}"
                            Content="GET"
                            Command="{x:Bind ViewModel.GetCommand}"
                            IsEnabled="{x:Bind ViewModel.CanGet, Mode=OneWay}"
                            AutomationProperties.Name="Open official download page"
                            AutomationProperties.HelpText="Opens the official site or store URI. UnboundOS does not download the installer." />
                        <ProgressRing
                            Width="22"
                            Height="22"
                            IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                            AutomationProperties.Name="Tool scan in progress" />
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="1" Spacing="16">
                    <Border Style="{StaticResource PanelBorderStyle}">
                        <StackPanel Spacing="8">
                            <TextBlock Style="{StaticResource PanelLabelText}" Foreground="{StaticResource PaperBrush}" Text="{x:Bind ViewModel.SelectedName, Mode=OneWay}" />
                            <TextBlock
                                Style="{StaticResource BodyMutedText}"
                                Text="{x:Bind ViewModel.Status, Mode=OneWay}"
                                TextWrapping="Wrap"
                                AutomationProperties.LiveSetting="Polite" />
                        </StackPanel>
                    </Border>

                    <InfoBar
                        IsOpen="{x:Bind ViewModel.ShowObsNeedsInstall, Mode=OneWay}"
                        IsClosable="False"
                        Severity="Warning"
                        Title="OBS not installed"
                        Message="This crop recipe needs OBS Studio. Use Get, then paste the filters. Play native — never lower monitor resolution." />

                    <views:ObsCropRecipeView Visibility="{x:Bind ViewModel.ShowObsRecipe, Mode=OneWay}" />
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
