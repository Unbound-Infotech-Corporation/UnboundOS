<Page
    x:Class="UnboundOS.App.Views.ProfilesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:UnboundOS.Core.Models"
    Background="Transparent">

    <ScrollViewer Style="{StaticResource ConsolePageScrollStyle}" AutomationProperties.Name="Session profiles">
        <StackPanel Spacing="22">
            <StackPanel Spacing="6">
                <TextBlock Style="{StaticResource KickerText}" Text="LOCAL JSON" />
                <TextBlock Style="{StaticResource SectionTitleText}" Text="Profiles" />
                <TextBlock
                    Style="{StaticResource BodyMutedText}"
                    MaxWidth="820"
                    Text="JSON-backed profiles in your LocalAppData. Pick a tile, then review what it terminates and protects." />
            </StackPanel>

            <TextBlock Style="{StaticResource TileRowLabelText}" Text="LIBRARY" />
            <ListView
                Height="320"
                ItemsSource="{x:Bind ViewModel.Profiles, Mode=OneWay}"
                SelectedItem="{x:Bind ViewModel.SelectedProfile, Mode=TwoWay}"
                SelectionMode="Single"
                Style="{StaticResource ConsoleListViewStyle}"
                ItemContainerStyle="{StaticResource ConsoleTileItemStyle}"
                AutomationProperties.Name="Saved session profiles">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:SessionProfile">
                        <Border Style="{StaticResource ConsoleTileCardStyle}">
                            <Grid>
                                <Border Style="{StaticResource ConsoleTileArtStyle}" />
                                <TextBlock Style="{StaticResource TileMonogramText}" Text="{x:Bind Monogram}" />
                                <StackPanel VerticalAlignment="Bottom" Padding="18,14">
                                    <TextBlock Style="{StaticResource TileCaptionText}" Text="{x:Bind Name}" />
                                    <TextBlock Style="{StaticResource TileMetaText}" Text="{x:Bind KindLabel}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <TextBlock
                Style="{StaticResource BodyMutedText}"
                MaxWidth="820"
                Text="{x:Bind ViewModel.SelectedProfile.Description, Mode=OneWay}" />
            <TextBlock
                Style="{StaticResource BodyMutedText}"
                Foreground="{StaticResource CyanPulseBrush}"
                MaxWidth="820"
                Text="{x:Bind ViewModel.SelectedProfile.SkinnySummary, Mode=OneWay}" />

            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource PanelBorderStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock Style="{StaticResource PanelLabelText}" Foreground="{StaticResource AlertAmberBrush}" Text="TERMINATE" />
                        <TextBlock Text="{x:Bind ViewModel.DenylistPreview, Mode=OneWay}" Style="{StaticResource BodyMutedText}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource PanelBorderStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock Style="{StaticResource PanelLabelText}" Text="PROTECT" />
                        <TextBlock Text="{x:Bind ViewModel.ProtectPreview, Mode=OneWay}" Style="{StaticResource BodyMutedText}" />
                    </StackPanel>
                </Border>
            </Grid>

            <Button
                Style="{StaticResource GhostButtonStyle}"
                HorizontalAlignment="Left"
                Content="RESET DEFAULTS"
                Command="{x:Bind ViewModel.ResetDefaultsCommand}"
                AutomationProperties.Name="Reset default profiles" />
        </StackPanel>
    </ScrollViewer>
</Page>
