<Page
    x:Class="UnboundOS.App.Views.GuidePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:UnboundOS.Core.Models"
    NavigationCacheMode="Required"
    Background="Transparent">

    <ScrollViewer Style="{StaticResource ConsolePageScrollStyle}" AutomationProperties.Name="Guide">
        <StackPanel Spacing="22" MaxWidth="820">
            <StackPanel Spacing="6">
                <TextBlock Style="{StaticResource KickerText}" Text="GUIDE" />
                <TextBlock Style="{StaticResource SectionTitleText}" Text="Quick menu" />
                <TextBlock Style="{StaticResource BodyMutedText}" Text="{x:Bind ViewModel.Honesty}" />
                <TextBlock Style="{StaticResource BodyMutedText}" Text="{x:Bind ViewModel.ControllerHonesty}" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Style="{StaticResource SignalButtonStyle}" Content="DO" Command="{x:Bind ViewModel.InvokeCommand}" AutomationProperties.Name="Invoke Guide action" />
                <Button Style="{StaticResource GhostButtonStyle}" Content="RESUME LAST GAME" Command="{x:Bind ViewModel.ResumeLastCommand}" AutomationProperties.Name="Resume last game" />
            </StackPanel>

            <ListView
                MinHeight="280"
                ItemsSource="{x:Bind ViewModel.Actions, Mode=OneWay}"
                SelectedItem="{x:Bind ViewModel.SelectedAction, Mode=TwoWay}"
                Style="{StaticResource SuperCleanListViewStyle}"
                ItemContainerStyle="{StaticResource SuperCleanListItemStyle}"
                AutomationProperties.Name="Guide actions">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:GuideAction">
                        <StackPanel Spacing="4" Padding="0,6">
                            <TextBlock FontFamily="{StaticResource UiFontSemiboldFamily}" Foreground="{StaticResource PaperBrush}" Text="{x:Bind Title}" />
                            <TextBlock Style="{StaticResource BodyMutedText}" FontSize="14" Text="{x:Bind Hint}" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <TextBlock Style="{StaticResource BodyMutedText}" Foreground="{StaticResource CyanPulseBrush}" Text="{x:Bind ViewModel.Status, Mode=OneWay}" />
            <TextBlock Style="{StaticResource BodyMutedText}" Text="{x:Bind ViewModel.ResumeStatus, Mode=OneWay}" />
        </StackPanel>
    </ScrollViewer>
</Page>
