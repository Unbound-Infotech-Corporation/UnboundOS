<Page
    x:Class="UnboundOS.App.Views.FilesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:UnboundOS.Core.Models"
    Background="Transparent">

    <ScrollViewer Style="{StaticResource ConsolePageScrollStyle}" AutomationProperties.Name="Unbound Files">
        <StackPanel Spacing="22">
            <StackPanel Spacing="6">
                <TextBlock Style="{StaticResource KickerText}" Text="FILES" />
                <TextBlock Style="{StaticResource SectionTitleText}" Text="Unbound Files" />
                <TextBlock
                    Style="{StaticResource BodyMutedText}"
                    MaxWidth="820"
                    Text="{x:Bind ViewModel.Honesty}" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Style="{StaticResource GhostButtonStyle}" Content="UP" Command="{x:Bind ViewModel.GoParentCommand}" AutomationProperties.Name="Go to parent folder" />
                <Button Style="{StaticResource GhostButtonStyle}" Content="OPEN" Command="{x:Bind ViewModel.OpenSelectedCommand}" AutomationProperties.Name="Open selected folder" />
                <Button Style="{StaticResource SignalButtonStyle}" Content="SHOW IN EXPLORER" Command="{x:Bind ViewModel.RevealInExplorerCommand}" AutomationProperties.Name="Show in Windows Explorer" />
            </StackPanel>

            <TextBlock FontFamily="{StaticResource MonoFontFamily}" FontSize="12" Foreground="{StaticResource CyanPulseBrush}" Text="{x:Bind ViewModel.CurrentPath, Mode=OneWay}" />

            <TextBlock Style="{StaticResource TileRowLabelText}" Text="PLACES" />
            <ItemsControl ItemsSource="{x:Bind ViewModel.Places, Mode=OneWay}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="8" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:FilePlace">
                        <Button
                            Style="{StaticResource GhostButtonStyle}"
                            Content="{x:Bind Label}"
                            Tag="{x:Bind}"
                            Click="Place_Click"
                            AutomationProperties.Name="{x:Bind Label}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Style="{StaticResource PanelBorderStyle}">
                <ListView
                    MinHeight="280"
                    ItemsSource="{x:Bind ViewModel.Entries, Mode=OneWay}"
                    SelectedItem="{x:Bind ViewModel.SelectedEntry, Mode=TwoWay}"
                    IsItemClickEnabled="True"
                    ItemClick="Entries_ItemClick"
                    AutomationProperties.Name="Folder contents">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:FileBrowseEntry">
                            <Grid ColumnSpacing="16" Padding="0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="120" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource MicroLabelText}" Text="{x:Bind KindLabel}" />
                                <TextBlock Grid.Column="1" FontFamily="{StaticResource UiFontSemiboldFamily}" Foreground="{StaticResource PaperBrush}" Text="{x:Bind Name}" />
                                <TextBlock Grid.Column="2" FontFamily="{StaticResource MonoFontFamily}" FontSize="12" Foreground="{StaticResource MutedTextBrush}" Text="{x:Bind SizeLabel}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>

            <TextBlock Style="{StaticResource BodyMutedText}" Text="{x:Bind ViewModel.Status, Mode=OneWay}" />
        </StackPanel>
    </ScrollViewer>
</Page>
