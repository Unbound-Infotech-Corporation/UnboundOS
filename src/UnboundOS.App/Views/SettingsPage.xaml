<Page
    x:Class="UnboundOS.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <ScrollViewer Style="{StaticResource ConsolePageScrollStyle}" AutomationProperties.Name="Settings">
        <StackPanel Spacing="22" MaxWidth="820">
            <StackPanel Spacing="6">
                <TextBlock Style="{StaticResource KickerText}" Text="SHELL" />
                <TextBlock Style="{StaticResource SectionTitleText}" Text="Settings" />
                <TextBlock
                    Style="{StaticResource BodyMutedText}"
                    Text="Interface motion is on by default. Turn it off for instant cyan states. Windows Animation effects also pause it. A live session pauses it without hiding this toggle." />
            </StackPanel>

            <Border Style="{StaticResource PanelBorderStyle}">
                <StackPanel Spacing="16">
                    <TextBlock Style="{StaticResource PanelLabelText}" Text="INTERFACE MOTION" />
                    <ToggleSwitch
                        MinHeight="48"
                        IsOn="{x:Bind ViewModel.InterfaceMotionEnabled, Mode=TwoWay}"
                        OnContent="On"
                        OffContent="Off"
                        Header="Scale, glow bloom, press squash, and a one-shot sheen on the focused tile or button."
                        AutomationProperties.Name="Interface motion"
                        AutomationProperties.HelpText="When off, tiles and buttons use instant visual states only. Keyboard focus and narrator stay available either way." />
                    <TextBlock
                        Style="{StaticResource BodyMutedText}"
                        Text="{x:Bind ViewModel.MotionStatus, Mode=OneWay}"
                        AutomationProperties.LiveSetting="Polite" />
                    <TextBlock
                        Style="{StaticResource BodyMutedText}"
                        Foreground="{StaticResource CyanPulseBrush}"
                        Text="{x:Bind ViewModel.SessionNote}" />
                    <TextBlock
                        Style="{StaticResource BodyMutedText}"
                        Text="Motion runs on the compositor. UnboundOS does not run per-frame layout loops or loop a sheen on every tile at once." />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
