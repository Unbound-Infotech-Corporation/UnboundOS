<Page
    x:Class="UnboundOS.App.Views.SwitcherPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:UnboundOS.Core.Models"
    NavigationCacheMode="Required"
    Background="Transparent">

    <ScrollViewer Style="{StaticResource ConsolePageScrollStyle}" AutomationProperties.Name="Running apps">
        <StackPanel Spacing="22">
            <StackPanel Spacing="6">
                <TextBlock Style="{StaticResource KickerText}" Text="SWITCH" />
                <TextBlock Style="{StaticResource SectionTitleText}" Text="Running apps" />
                <TextBlock Style="{StaticResource BodyMutedText}" MaxWidth="820" Text="{x:Bind ViewModel.Honesty}" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Style="{StaticResource SignalButtonStyle}" Content="FOCUS" Command="{x:Bind ViewModel.ActivateCommand}" AutomationProperties.Name="Focus selected window" />
                <Button Style="{StaticResource GhostButtonStyle}" Content="CLOSE" Command="{x:Bind ViewModel.CloseSelectedCommand}" AutomationProperties.Name="Close selected window" />
                <Button Style="{StaticResource GhostButtonStyle}" Content="REFRESH" Command="{x:Bind ViewModel.RefreshCommand}" AutomationProperties.Name="Refresh running apps" />
            </StackPanel>

            <ListView
                MinHeight="280"
                ItemsSource="{x:Bind ViewModel.Apps, Mode=OneWay}"
                SelectedItem="{x:Bind ViewModel.SelectedApp, Mode=TwoWay}"
                Style="{StaticResource SuperCleanListViewStyle}"
                ItemContainerStyle="{StaticResource SuperCleanListItemStyle}"
                AutomationProperties.Name="Running windows">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:RunningApp">
                        <Grid ColumnSpacing="16" Padding="0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource MicroLabelText}" Text="{x:Bind ProcessName}" />
                            <TextBlock Grid.Column="1" FontFamily="{StaticResource UiFontSemiboldFamily}" Foreground="{StaticResource PaperBrush}" Text="{x:Bind Title}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <TextBlock Style="{StaticResource TileRowLabelText}" Text="BACKGROUND" />
            <ListView
                MinHeight="120"
                ItemsSource="{x:Bind ViewModel.Tray, Mode=OneWay}"
                Style="{StaticResource SuperCleanListViewStyle}"
                ItemContainerStyle="{StaticResource SuperCleanListItemStyle}"
                AutomationProperties.Name="Background apps">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:TrayApp">
                        <Grid ColumnSpacing="16" Padding="0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="80" />
                            </Grid.ColumnDefinitions>
                            <TextBlock FontFamily="{StaticResource UiFontSemiboldFamily}" Foreground="{StaticResource PaperBrush}" Text="{x:Bind Title}" />
                            <TextBlock Grid.Column="1" Style="{StaticResource MicroLabelText}" Text="{x:Bind ProcessName}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <TextBlock Style="{StaticResource BodyMutedText}" Text="{x:Bind ViewModel.Status, Mode=OneWay}" />
        </StackPanel>
    </ScrollViewer>
</Page>
