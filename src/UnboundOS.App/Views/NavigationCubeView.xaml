<UserControl
    x:Class="UnboundOS.App.Views.NavigationCubeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsTabStop="True"
    UseSystemFocusVisuals="True"
    XYFocusKeyboardNavigation="Disabled"
    AllowFocusOnInteraction="True"
    KeyDown="OnKeyDown"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch"
    AutomationProperties.Name="UnboundOS Home galaxy"
    AutomationProperties.HelpText="Left and right shift nodes along the galaxy. Up opens that node's list from the bottom. Down opens that node's list from the top. Escape returns to the galaxy. SET zooms to Options. Profiles is the other corner glyph.">

    <Grid
        x:Name="PerspectiveHost"
        Style="{StaticResource CubeHostStyle}"
        AutomationProperties.Name="Linear galaxy">
        <WebView2
            x:Name="CubeWeb"
            DefaultBackgroundColor="#FF000000"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            IsTabStop="False"
            AllowFocusOnInteraction="False"
            AutomationProperties.AccessibilityView="Raw" />
        <Border
            x:Name="FallbackCard"
            Visibility="Collapsed"
            Background="{StaticResource HomeAshBrush}"
            BorderBrush="{StaticResource HomePlaqueStrokeBrush}"
            BorderThickness="1"
            CornerRadius="2"
            Width="280"
            Height="280"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            PointerPressed="OnFallbackPressed">
            <Grid>
                <TextBlock
                    x:Name="FallbackKicker"
                    Style="{StaticResource MicroLabelText}"
                    Margin="16,14"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Text="SYS" />
                <TextBlock
                    x:Name="FallbackMonogram"
                    Style="{StaticResource TileMonogramText}"
                    FontSize="84"
                    Text="S" />
                <StackPanel VerticalAlignment="Bottom" Padding="18,16">
                    <TextBlock x:Name="FallbackTitle" Style="{StaticResource TileCaptionText}" FontSize="22" Text="Session" />
                    <TextBlock Style="{StaticResource TileMetaText}" Text="ENTER" />
                </StackPanel>
            </Grid>
        </Border>
        <TextBlock
            x:Name="FrontCaption"
            Visibility="Collapsed"
            Style="{StaticResource TileCaptionText}"
            Text="Session"
            AutomationProperties.LiveSetting="Polite" />
        <Border
            x:Name="FocusRing"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            BorderBrush="{StaticResource HomePlaqueStrokeBrush}"
            BorderThickness="1"
            Opacity="0"
            IsHitTestVisible="False" />
    </Grid>
</UserControl>
