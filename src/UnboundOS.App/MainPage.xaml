            Padding="28,14,28,12"
            BorderBrush="{StaticResource LineSubtleBrush}"
            BorderThickness="0,0,0,1"
            Background="{StaticResource TelemetryStripBrush}"
            AutomationProperties.Name="Console chrome">
            <Grid ColumnSpacing="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Grid Width="28" Height="28" AutomationProperties.Name="Unbound Infotech mark">
                        <Border Background="{StaticResource CyanPulseBrush}" CornerRadius="2" />
                        <Border Margin="7" Background="{StaticResource ObsidianBrush}" CornerRadius="1" />
                        <Rectangle Width="6" Height="1" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,2,0" Fill="{StaticResource CircuitAmberBrush}" />
                        <Rectangle Width="1" Height="6" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,2,0" Fill="{StaticResource CircuitAmberBrush}" />
                    </Grid>
                    <StackPanel VerticalAlignment="Center" Spacing="0">
                        <TextBlock
                            Style="{StaticResource BrandDisplayText}"
                            FontSize="18"
                            CharacterSpacing="20"
                            Text="{x:Bind ViewModel.ProductName}"
                            Foreground="{StaticResource CyanPulseBrush}" />
                        <TextBlock Style="{StaticResource MicroLabelText}" Text="SYS" Opacity="0.85" />
                    </StackPanel>
                </StackPanel>

                <StackPanel
                    x:Name="NavRail"
                    Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="4"
                    VerticalAlignment="Center"
                    XYFocusKeyboardNavigation="Enabled"
                    AutomationProperties.Name="Primary navigation">
                    <Button x:Name="HomeNav" Tag="Home" Style="{StaticResource TopNavButtonStyle}" Click="Nav_Click" Background="{StaticResource CyanDimFillBrush}" Foreground="{StaticResource CyanPulseBrush}" AutomationProperties.Name="Home">
                        <Grid>
                            <TextBlock Text="HOME" Margin="0,0,0,4" />
                            <Rectangle x:Name="HomeAccent" Height="2" VerticalAlignment="Bottom" Fill="{StaticResource CyanPulseBrush}" />
                        </Grid>
                    </Button>
                    <Button x:Name="SessionNav" Tag="Session" Style="{StaticResource TopNavButtonStyle}" Click="Nav_Click" AutomationProperties.Name="Session">
                        <Grid>
                            <TextBlock Text="SESSION" Margin="0,0,0,4" />
                            <Rectangle x:Name="SessionAccent" Height="2" VerticalAlignment="Bottom" Fill="{StaticResource CyanPulseBrush}" Opacity="0" />
                        </Grid>
                    </Button>
                    <Button x:Name="NetworkNav" Tag="Network" Style="{StaticResource TopNavButtonStyle}" Click="Nav_Click" AutomationProperties.Name="Network">
                        <Grid>
                            <TextBlock Text="NETWORK" Margin="0,0,0,4" />
                            <Rectangle x:Name="NetworkAccent" Height="2" VerticalAlignment="Bottom" Fill="{StaticResource CyanPulseBrush}" Opacity="0" />
                        </Grid>
                    </Button>
                    <Button x:Name="ToolsNav" Tag="Tools" Style="{StaticResource TopNavButtonStyle}" Click="Nav_Click" AutomationProperties.Name="Tools">
                        <Grid>
                            <TextBlock Text="TOOLS" Margin="0,0,0,4" />
