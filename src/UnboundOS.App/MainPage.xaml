<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="UnboundOS.App.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource VoidBlackBrush}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Rail -->
        <Border Grid.Column="0" Background="{StaticResource InkPanelBrush}" BorderBrush="#18FFFFFF" BorderThickness="0,0,1,0" Padding="20,24">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Spacing="4">
                    <TextBlock Style="{StaticResource BrandDisplayText}" FontSize="28" Text="{x:Bind ViewModel.ProductName}" Foreground="{StaticResource SignalLimeBrush}" />
                    <TextBlock Text="{x:Bind ViewModel.CompanyName}" FontSize="10" Foreground="{StaticResource MutedSteelBrush}" TextWrapping="Wrap" CharacterSpacing="40" />
                </StackPanel>

                <StackPanel Grid.Row="1" Spacing="6" Margin="0,36,0,0">
                    <Button Content="HOME" Tag="Home" Style="{StaticResource GhostButtonStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="Nav_Click" />
                    <Button Content="SESSION" Tag="Session" Style="{StaticResource GhostButtonStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="Nav_Click" />
                    <Button Content="NETWORK" Tag="Network" Style="{StaticResource GhostButtonStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="Nav_Click" />
                    <Button Content="STREAM" Tag="Stream" Style="{StaticResource GhostButtonStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="Nav_Click" />
                    <Button Content="MODS + WORKSHOP" Tag="Mods" Style="{StaticResource GhostButtonStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="Nav_Click" AutomationProperties.Name="Mods and Steam Workshop" />
                    <Button Content="PROFILES" Tag="Profiles" Style="{StaticResource GhostButtonStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="Nav_Click" />
                </StackPanel>

                <StackPanel Grid.Row="2" Spacing="6">
                    <TextBlock FontFamily="Cascadia Mono" FontSize="11" Foreground="{StaticResource MutedSteelBrush}" Text="{x:Bind ViewModel.VersionText}" />
                    <TextBlock FontFamily="Bahnschrift" FontSize="12" Foreground="{StaticResource SignalLimeBrush}" Text="{x:Bind ViewModel.SessionStateText, Mode=OneWay}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Stage -->
        <Grid Grid.Column="1">
            <Grid.Background>
                <StaticResource ResourceKey="HeroAtmosphereBrush" />
            </Grid.Background>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Telemetry strip -->
            <Border Grid.Row="0" Background="#88070A0D" Padding="28,16" BorderBrush="#14FFFFFF" BorderThickness="0,0,0,1">
                <Grid ColumnSpacing="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock FontFamily="Bahnschrift" FontSize="12" Foreground="{StaticResource MutedSteelBrush}" Text="STATUS" CharacterSpacing="80" />
                        <TextBlock Text="{x:Bind ViewModel.StatusLine, Mode=OneWay}" Foreground="{StaticResource WarmPaperBrush}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock FontFamily="Bahnschrift" FontSize="12" Foreground="{StaticResource MutedSteelBrush}" Text="CPU" />
                        <TextBlock FontFamily="Cascadia Mono" Foreground="{StaticResource IceTelemetryBrush}" Text="{x:Bind ViewModel.CpuUsage, Mode=OneWay}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock FontFamily="Bahnschrift" FontSize="12" Foreground="{StaticResource MutedSteelBrush}" Text="MEMORY" />
                        <TextBlock FontFamily="Cascadia Mono" Foreground="{StaticResource IceTelemetryBrush}" Text="{x:Bind ViewModel.MemoryText, Mode=OneWay}" />
                    </StackPanel>
                    <StackPanel Grid.Column="3">
                        <TextBlock FontFamily="Bahnschrift" FontSize="12" Foreground="{StaticResource MutedSteelBrush}" Text="PROCESSES" />
                        <TextBlock FontFamily="Cascadia Mono" Foreground="{StaticResource IceTelemetryBrush}" Text="{x:Bind ViewModel.ProcessCount, Mode=OneWay}" />
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock FontFamily="Bahnschrift" FontSize="12" Foreground="{StaticResource MutedSteelBrush}" Text="SUSPECTS" />
                        <TextBlock FontFamily="Cascadia Mono" Foreground="{StaticResource AlertAmberBrush}" Text="{x:Bind ViewModel.SuspectCount, Mode=OneWay}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <!-- Home hero -->
                <ScrollViewer x:Name="HomeView" Padding="40,32">
                    <StackPanel Spacing="28" MaxWidth="980" VerticalAlignment="Center">
                        <StackPanel Spacing="10">
                            <TextBlock Style="{StaticResource BrandDisplayText}" FontSize="72" Text="UnboundOS" Foreground="{StaticResource WarmPaperBrush}" />
                            <Rectangle Height="3" Width="220" HorizontalAlignment="Left" Fill="{StaticResource SignalSweepBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.Tagline}" FontSize="22" FontFamily="Segoe UI Variable Text" Foreground="{StaticResource SignalLimeBrush}" />
                            <TextBlock
                                Style="{StaticResource BodyMutedText}"
                                FontSize="16"
                                MaxWidth="640"
                                Text="A Windows gaming session shell from Unbound Infotech Corporation. Strip the noise, split your NICs, crop ultrawide for Twitch — then restore the desktop when you are done." />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Button Style="{StaticResource SignalButtonStyle}" Content="START SESSION" Click="GoSession_Click" />
                            <Button Style="{StaticResource GhostButtonStyle}" Content="STREAM CANVAS" Click="GoStream_Click" />
                            <Button Style="{StaticResource GhostButtonStyle}" Content="NETWORK SPLIT" Click="GoNetwork_Click" />
                            <Button Style="{StaticResource GhostButtonStyle}" Content="MODS + WORKSHOP" Click="GoMods_Click" />
                        </StackPanel>

                        <Grid ColumnSpacing="14" Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource PanelBorderStyle}" Grid.Column="0">
                                <StackPanel Spacing="8">
                                    <TextBlock FontFamily="Bahnschrift" Foreground="{StaticResource SignalLimeBrush}" Text="SESSION" />
                                    <TextBlock Style="{StaticResource BodyMutedText}" Text="Enter a profile that clears denylist junk and keeps anticheat/game processes protected." />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource PanelBorderStyle}" Grid.Column="1">
                                <StackPanel Spacing="8">
                                    <TextBlock FontFamily="Bahnschrift" Foreground="{StaticResource IceTelemetryBrush}" Text="NETWORK" />
                                    <TextBlock Style="{StaticResource BodyMutedText}" Text="Prefer the game NIC. Park OBS upload on the second adapter so stream bitrate cannot choke ping." />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource PanelBorderStyle}" Grid.Column="2">
                                <StackPanel Spacing="8">
                                    <TextBlock FontFamily="Bahnschrift" Foreground="{StaticResource AlertAmberBrush}" Text="STREAM" />
                                    <TextBlock Style="{StaticResource BodyMutedText}" Text="5110×1400 → center 16:9 → 1080p60 with Lanczos + sharpen. Copy OBS filters in one click." />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <Frame x:Name="ContentFrame" Visibility="Collapsed" />
            </Grid>
        </Grid>
    </Grid>
</Page>
