<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="UnboundOS.App.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource ObsidianBrush}">

    <Grid>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="NavStates">
                <VisualState x:Name="Home">
                    <VisualState.Setters>
                        <Setter Target="HomeAccent.Opacity" Value="1" />
                        <Setter Target="HomeNav.Background" Value="{StaticResource CyanDimFillBrush}" />
                        <Setter Target="HomeNav.Foreground" Value="{StaticResource CyanPulseBrush}" />
                        <Setter Target="SessionAccent.Opacity" Value="0" />
                        <Setter Target="SessionNav.Background" Value="Transparent" />
                        <Setter Target="SessionNav.Foreground" Value="{StaticResource MutedTextBrush}" />
                        <Setter Target="NetworkAccent.Opacity" Value="0" />
                        <Setter Target="NetworkNav.Background" Value="Transparent" />
                        <Setter Target="NetworkNav.Foreground" Value="{StaticResource MutedTextBrush}" />
                        <Setter Target="StreamAccent.Opacity" Value="0" />
                        <Setter Target="StreamNav.Background" Value="Transparent" />
                        <Setter Target="StreamNav.Foreground" Value="{StaticResource MutedTextBrush}" />
                        <Setter Target="ModsAccent.Opacity" Value="0" />
                        <Setter Target="ModsNav.Background" Value="Transparent" />
                        <Setter Target="ModsNav.Foreground" Value="{StaticResource MutedTextBrush}" />
                        <Setter Target="ProfilesAccent.Opacity" Value="0" />
                        <Setter Target="ProfilesNav.Background" Value="Transparent" />
                        <Setter Target="ProfilesNav.Foreground" Value="{StaticResource MutedTextBrush}" />
                        <Setter Target="OverlayAccent.Opacity" Value="0" />
                        <Setter Target="OverlayNav.Background" Value="Transparent" />
                        <Setter Target="OverlayNav.Foreground" Value="{StaticResource MutedTextBrush}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Session">
                    <VisualState.Setters>
                        <Setter Target="HomeAccent.Opacity" Value="0" />
                        <Setter Target="HomeNav.Background" Value="Transparent" />
                        <Setter Target="HomeNav.Foreground" Value="{StaticResource MutedTextBrush}" />
                        <Setter Target="SessionAccent.Opacity" Value="1" />
                        <Setter Target="SessionNav.Background" Value="{StaticResource CyanDimFillBrush}" />
                        <Setter Target="SessionNav.Foreground" Value="{StaticResource CyanPulseBrush}" />
                        <Setter Target="NetworkAccent.Opacity" Value="0" />
                        <Setter Target="NetworkNav.Background" Value="Transparent" />
                        <Setter Target="NetworkNav.Foreground" Value="{StaticResource MutedTextBrush}" />
                        <Setter Target="StreamAccent.Opacity" Value="0" />
                        <Setter Target="StreamNav.Background" Value="Transparent" />
                        <Setter Target="StreamNav.Foreground" Value="{StaticResource MutedTextBrush}" />
                        <Setter Target="ModsAccent.Opacity" Value="0" />
                        <Setter Target="ModsNav.Background" Value="Transparent" />
                        <Setter Target="ModsNav.Foreground" Value="{StaticResource MutedTextBrush}" />
                        <Setter Target="ProfilesAccent.Opacity" Value="0" />
                        <Setter Target="ProfilesNav.Background" Value="Transparent" />
                        <Setter Target="ProfilesNav.Foreground" Value="{StaticResource MutedTextBrush}" />
                        <Setter Target="OverlayAccent.Opacity" Value="0" />
                        <Setter Target="OverlayNav.Background" Value="Transparent" />
                        <Setter Target="OverlayNav.Foreground" Value="{StaticResource MutedTextBrush}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Network">
                    <VisualState.Setters>
                        <Setter Target="HomeAccent.Opacity" Value="0" />
                        <Setter Target="HomeNav.Background" Value="Transparent" />
                        <Setter Target="HomeNav.Foreground" Value="{StaticResource MutedTextBrush}" />
                        <Setter Target="SessionAccent.Opacity" Value="0" />
                        <Setter Target="SessionNav.Background" Value="Transparent" />
                        <Setter Target="SessionNav.Foreground" Value="{StaticResource MutedTextBrush}" />
                        <Setter Target="NetworkAccent.Opacity" Value="1" />
                        <Setter Target="NetworkNav.Background" Value="{StaticResource CyanDimFillBrush}" />
                        <Setter Target="NetworkNav.Foreground" Value="{StaticResource CyanPulseBrush}" />
                        <Setter Target="StreamAccent.Opacity" Value="0" />
                        <Setter Target="StreamNav.Background" Value="Transparent" />
                        <Setter Target="StreamNav.Foreground" Value="{StaticResource MutedTextBrush}" />
                        <Setter Target="ModsAccent.Opacity" Value="0" />
                        <Setter Target="ModsNav.Background" Value="Transparent" />
                        <Setter Target="ModsNav.Foreground" Value="{StaticResource MutedTextBrush}" />
                        <Setter Target="ProfilesAccent.Opacity" Value="0" />
                        <Setter Target="ProfilesNav.Background" Value="Transparent" />
                        <Setter Target="ProfilesNav.Foreground" Value="{StaticResource MutedTextBrush}" />
                        <Setter Target="OverlayAccent.Opacity" Value="0" />
                        <Setter Target="OverlayNav.Background" Value="Transparent" />
                        <Setter Target="OverlayNav.Foreground" Value="{StaticResource MutedTextBrush}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Stream">
                    <VisualState.Setters>
                        <Setter Target="HomeAccent.Opacity" Value="0" />
                        <Setter Target="HomeNav.Background" Value="Transparent" />
                        <Setter Target="HomeNav.Foreground" Value="{StaticResource MutedTextBrush}" />
                        <Setter Target="SessionAccent.Opacity" Value="0" />
                        <Setter Target="SessionNav.Background" Value="Transparent" />
                        <Setter Target="SessionNav.Foreground" Value="{StaticResource MutedTextBrush}" />
                        <Setter Target="NetworkAccent.Opacity" Value="0" />
                        <Setter Target="NetworkNav.Background" Value="Transparent" />
                        <Setter Target="NetworkNav.Foreground" Value="{StaticResource MutedTextBrush}" />
                        <Setter Target="StreamAccent.Opacity" Value="1" />
                        <Setter Target="StreamNav.Background" Value="{StaticResource CyanDimFillBrush}" />
                        <Setter Target="StreamNav.Foreground" Value="{StaticResource CyanPulseBrush}" />
                        <Setter Target="ModsAccent.Opacity" Value="0" />
                        <Setter Target="ModsNav.Background" Value="Transparent" />
                        <Setter Target="ModsNav.Foreground" Value="{StaticResource MutedTextBrush}" />
                        <Setter Target="ProfilesAccent.Opacity" Value="0" />
                        <Setter Target="ProfilesNav.Background" Value="Transparent" />
                        <Setter Target="ProfilesNav.Foreground" Value="{StaticResource MutedTextBrush}" />
                        <Setter Target="OverlayAccent.Opacity" Value="0" />
                        <Setter Target="OverlayNav.Background" Value="Transparent" />
                        <Setter Target="OverlayNav.Foreground" Value="{StaticResource MutedTextBrush}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Mods">
                    <VisualState.Setters>
                        <Setter Target="HomeAccent.Opacity" Value="0" />
                        <Setter Target="HomeNav.Background" Value="Transparent" />
                        <Setter Target="HomeNav.Foreground" Value="{StaticResource MutedTextBrush}" />
                        <Setter Target="SessionAccent.Opacity" Value="0" />
                        <Setter Target="SessionNav.Background" Value="Transparent" />
                        <Setter Target="SessionNav.Foreground" Value="{StaticResource MutedTextBrush}" />
                        <Setter Target="NetworkAccent.Opacity" Value="0" />
                        <Setter Target="NetworkNav.Background" Value="Transparent" />
                        <Setter Target="NetworkNav.Foreground" Value="{StaticResource MutedTextBrush}" />
                        <Setter Target="StreamAccent.Opacity" Value="0" />
                        <Setter Target="StreamNav.Background" Value="Transparent" />
                        <Setter Target="StreamNav.Foreground" Value="{StaticResource MutedTextBrush}" />
                        <Setter Target="ModsAccent.Opacity" Value="1" />
                        <Setter Target="ModsNav.Background" Value="{StaticResource CyanDimFillBrush}" />
                        <Setter Target="ModsNav.Foreground" Value="{StaticResource CyanPulseBrush}" />
                        <Setter Target="ProfilesAccent.Opacity" Value="0" />
                        <Setter Target="ProfilesNav.Background" Value="Transparent" />
                        <Setter Target="ProfilesNav.Foreground" Value="{StaticResource MutedTextBrush}" />
                        <Setter Target="OverlayAccent.Opacity" Value="0" />
                        <Setter Target="OverlayNav.Background" Value="Transparent" />
                        <Setter Target="OverlayNav.Foreground" Value="{StaticResource MutedTextBrush}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Profiles">
                    <VisualState.Setters>
                        <Setter Target="HomeAccent.Opacity" Value="0" />
                        <Setter Target="HomeNav.Background" Value="Transparent" />
                        <Setter Target="HomeNav.Foreground" Value="{StaticResource MutedTextBrush}" />
                        <Setter Target="SessionAccent.Opacity" Value="0" />
                        <Setter Target="SessionNav.Background" Value="Transparent" />
                        <Setter Target="SessionNav.Foreground" Value="{StaticResource MutedTextBrush}" />
                        <Setter Target="NetworkAccent.Opacity" Value="0" />
                        <Setter Target="NetworkNav.Background" Value="Transparent" />
                        <Setter Target="NetworkNav.Foreground" Value="{StaticResource MutedTextBrush}" />
                        <Setter Target="StreamAccent.Opacity" Value="0" />
                        <Setter Target="StreamNav.Background" Value="Transparent" />
                        <Setter Target="StreamNav.Foreground" Value="{StaticResource MutedTextBrush}" />
                        <Setter Target="ModsAccent.Opacity" Value="0" />
                        <Setter Target="ModsNav.Background" Value="Transparent" />
                        <Setter Target="ModsNav.Foreground" Value="{StaticResource MutedTextBrush}" />
                        <Setter Target="ProfilesAccent.Opacity" Value="1" />
                        <Setter Target="ProfilesNav.Background" Value="{StaticResource CyanDimFillBrush}" />
                        <Setter Target="ProfilesNav.Foreground" Value="{StaticResource CyanPulseBrush}" />
                        <Setter Target="OverlayAccent.Opacity" Value="0" />
                        <Setter Target="OverlayNav.Background" Value="Transparent" />
                        <Setter Target="OverlayNav.Foreground" Value="{StaticResource MutedTextBrush}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Overlay">
                    <VisualState.Setters>
                        <Setter Target="HomeAccent.Opacity" Value="0" />
                        <Setter Target="HomeNav.Background" Value="Transparent" />
                        <Setter Target="HomeNav.Foreground" Value="{StaticResource MutedTextBrush}" />
                        <Setter Target="SessionAccent.Opacity" Value="0" />
                        <Setter Target="SessionNav.Background" Value="Transparent" />
                        <Setter Target="SessionNav.Foreground" Value="{StaticResource MutedTextBrush}" />
                        <Setter Target="NetworkAccent.Opacity" Value="0" />
                        <Setter Target="NetworkNav.Background" Value="Transparent" />
                        <Setter Target="NetworkNav.Foreground" Value="{StaticResource MutedTextBrush}" />
                        <Setter Target="StreamAccent.Opacity" Value="0" />
                        <Setter Target="StreamNav.Background" Value="Transparent" />
                        <Setter Target="StreamNav.Foreground" Value="{StaticResource MutedTextBrush}" />
                        <Setter Target="ModsAccent.Opacity" Value="0" />
                        <Setter Target="ModsNav.Background" Value="Transparent" />
                        <Setter Target="ModsNav.Foreground" Value="{StaticResource MutedTextBrush}" />
                        <Setter Target="ProfilesAccent.Opacity" Value="0" />
                        <Setter Target="ProfilesNav.Background" Value="Transparent" />
                        <Setter Target="ProfilesNav.Foreground" Value="{StaticResource MutedTextBrush}" />
                        <Setter Target="OverlayAccent.Opacity" Value="1" />
                        <Setter Target="OverlayNav.Background" Value="{StaticResource CyanDimFillBrush}" />
                        <Setter Target="OverlayNav.Foreground" Value="{StaticResource CyanPulseBrush}" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="236" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Rail -->
        <Border
            Grid.Column="0"
            Padding="18,22"
            BorderBrush="{StaticResource LineSubtleBrush}"
            BorderThickness="0,0,1,0">
            <Border.Background>
                <StaticResource ResourceKey="RailSheenBrush" />
            </Border.Background>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Grid Width="28" Height="28" AutomationProperties.Name="Unbound Infotech mark">
                            <Border Background="{StaticResource CyanPulseBrush}" CornerRadius="4" />
                            <Border Margin="7" Background="{StaticResource ObsidianBrush}" CornerRadius="2" />
                        </Grid>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock
                                Style="{StaticResource BrandDisplayText}"
                                FontSize="20"
                                CharacterSpacing="20"
                                Text="{x:Bind ViewModel.ProductName}"
                                Foreground="{StaticResource CyanPulseBrush}" />
                            <TextBlock
                                FontFamily="{StaticResource MonoFontFamily}"
                                FontSize="9"
                                Foreground="{StaticResource MutedTextBrush}"
                                Text="SESSION SHELL"
                                CharacterSpacing="60" />
                        </StackPanel>
                    </StackPanel>
                    <TextBlock
                        FontFamily="{StaticResource UiFontFamily}"
                        FontSize="11"
                        Foreground="{StaticResource MutedTextBrush}"
                        Text="{x:Bind ViewModel.CompanyName}"
                        TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel x:Name="NavRail" Grid.Row="1" Spacing="4" Margin="0,32,0,0" AutomationProperties.Name="Primary navigation">
                    <Button x:Name="HomeNav" Tag="Home" Style="{StaticResource NavRailButtonStyle}" Click="Nav_Click" Background="{StaticResource CyanDimFillBrush}" Foreground="{StaticResource CyanPulseBrush}" AutomationProperties.Name="Home">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Rectangle x:Name="HomeAccent" Fill="{StaticResource CyanPulseBrush}" RadiusX="1" RadiusY="1" />
                            <TextBlock Grid.Column="1" Text="HOME" />
                        </Grid>
                    </Button>
                    <Button x:Name="SessionNav" Tag="Session" Style="{StaticResource NavRailButtonStyle}" Click="Nav_Click" AutomationProperties.Name="Session">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Rectangle x:Name="SessionAccent" Fill="{StaticResource CyanPulseBrush}" Opacity="0" RadiusX="1" RadiusY="1" />
                            <TextBlock Grid.Column="1" Text="SESSION" />
                        </Grid>
                    </Button>
                    <Button x:Name="NetworkNav" Tag="Network" Style="{StaticResource NavRailButtonStyle}" Click="Nav_Click" AutomationProperties.Name="Network">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Rectangle x:Name="NetworkAccent" Fill="{StaticResource CyanPulseBrush}" Opacity="0" RadiusX="1" RadiusY="1" />
                            <TextBlock Grid.Column="1" Text="NETWORK" />
                        </Grid>
                    </Button>
                    <Button x:Name="StreamNav" Tag="Stream" Style="{StaticResource NavRailButtonStyle}" Click="Nav_Click" AutomationProperties.Name="Stream">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Rectangle x:Name="StreamAccent" Fill="{StaticResource CyanPulseBrush}" Opacity="0" RadiusX="1" RadiusY="1" />
                            <TextBlock Grid.Column="1" Text="STREAM" />
                        </Grid>
                    </Button>
                    <Button x:Name="ModsNav" Tag="Mods" Style="{StaticResource NavRailButtonStyle}" Click="Nav_Click" AutomationProperties.Name="Mods and Steam Workshop">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Rectangle x:Name="ModsAccent" Fill="{StaticResource CyanPulseBrush}" Opacity="0" RadiusX="1" RadiusY="1" />
                            <TextBlock Grid.Column="1" Text="MODS + WORKSHOP" />
                        </Grid>
                    </Button>
                    <Button x:Name="ProfilesNav" Tag="Profiles" Style="{StaticResource NavRailButtonStyle}" Click="Nav_Click" AutomationProperties.Name="Profiles">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Rectangle x:Name="ProfilesAccent" Fill="{StaticResource CyanPulseBrush}" Opacity="0" RadiusX="1" RadiusY="1" />
                            <TextBlock Grid.Column="1" Text="PROFILES" />
                        </Grid>
                    </Button>
                    <Button
                        x:Name="OverlayNav"
                        Tag="Overlay"
                        Style="{StaticResource NavRailButtonStyle}"
                        Click="Nav_Click"
                        Visibility="Collapsed"
                        AutomationProperties.Name="Desktop overlay addon">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Rectangle x:Name="OverlayAccent" Fill="{StaticResource CyanPulseBrush}" Opacity="0" RadiusX="1" RadiusY="1" />
                            <TextBlock Grid.Column="1" Text="OVERLAY" />
                        </Grid>
                    </Button>
                </StackPanel>

                <StackPanel Grid.Row="2" Spacing="6">
                    <TextBlock FontFamily="{StaticResource MonoFontFamily}" FontSize="11" Foreground="{StaticResource MutedTextBrush}" Text="{x:Bind ViewModel.VersionText}" />
                    <TextBlock FontFamily="{StaticResource MonoFontFamily}" FontSize="12" Foreground="{StaticResource CyanPulseBrush}" Text="{x:Bind ViewModel.SessionStateText, Mode=OneWay}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Stage -->
        <Grid Grid.Column="1">
            <Grid.Background>
                <StaticResource ResourceKey="HeroAtmosphereBrush" />
            </Grid.Background>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border
                Grid.Row="0"
                Background="{StaticResource TelemetryStripBrush}"
                Padding="28,14"
                BorderBrush="{StaticResource LineSubtleBrush}"
                BorderThickness="0,0,0,1"
                AutomationProperties.Name="Live telemetry">
                <Grid ColumnSpacing="28">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2">
                        <TextBlock Style="{StaticResource TelemetryLabelText}" Text="STATUS" />
                        <TextBlock FontFamily="{StaticResource UiFontFamily}" Foreground="{StaticResource PaperBrush}" Text="{x:Bind ViewModel.StatusLine, Mode=OneWay}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="2" AutomationProperties.Name="CPU usage">
                        <TextBlock Style="{StaticResource TelemetryLabelText}" Text="CPU" />
                        <TextBlock Style="{StaticResource TelemetryValueText}" Text="{x:Bind ViewModel.CpuUsageText, Mode=OneWay}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Spacing="2" AutomationProperties.Name="Memory usage">
                        <TextBlock Style="{StaticResource TelemetryLabelText}" Text="MEMORY" />
                        <TextBlock Style="{StaticResource TelemetryValueText}" Text="{x:Bind ViewModel.MemoryText, Mode=OneWay}" />
                    </StackPanel>
                    <StackPanel Grid.Column="3" Spacing="2" AutomationProperties.Name="Process count">
                        <TextBlock Style="{StaticResource TelemetryLabelText}" Text="PROCESSES" />
                        <TextBlock Style="{StaticResource TelemetryValueText}" Text="{x:Bind ViewModel.ProcessCount, Mode=OneWay}" />
                    </StackPanel>
                    <StackPanel Grid.Column="4" Spacing="2" AutomationProperties.Name="Denylist suspects">
                        <TextBlock Style="{StaticResource TelemetryLabelText}" Text="SUSPECTS" />
                        <TextBlock FontFamily="{StaticResource MonoFontFamily}" FontSize="14" Foreground="{StaticResource AlertAmberBrush}" Text="{x:Bind ViewModel.SuspectCount, Mode=OneWay}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <ScrollViewer x:Name="HomeView" Padding="40,32">
                    <StackPanel Spacing="28" MaxWidth="980" VerticalAlignment="Center">
                        <StackPanel Spacing="12">
                            <TextBlock Style="{StaticResource KickerText}" Text="WINDOWS 11 SESSION SHELL" />
                            <TextBlock Style="{StaticResource BrandDisplayText}" FontSize="68" Text="UnboundOS" Foreground="{StaticResource PaperBrush}" />
                            <Rectangle Height="2" Width="180" HorizontalAlignment="Left" Fill="{StaticResource SignalSweepBrush}" />
                            <TextBlock
                                Text="{x:Bind ViewModel.Tagline}"
                                FontSize="22"
                                FontFamily="{StaticResource UiFontSemiboldFamily}"
                                Foreground="{StaticResource CyanPulseBrush}" />
                            <TextBlock
                                Style="{StaticResource BodyMutedText}"
                                FontSize="16"
                                MaxWidth="640"
                                Text="From Unbound Infotech Corporation. UnboundOS does not replace Windows — it applies a focused gaming or streaming posture, then restores the desktop when you exit." />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button Style="{StaticResource SignalButtonStyle}" Content="START SESSION" Click="GoSession_Click" AutomationProperties.Name="Start session" />
                            <Button Style="{StaticResource GhostButtonStyle}" Content="STREAM CANVAS" Click="GoStream_Click" AutomationProperties.Name="Open stream canvas" />
                            <Button Style="{StaticResource GhostButtonStyle}" Content="NETWORK SPLIT" Click="GoNetwork_Click" AutomationProperties.Name="Open network director" />
                            <Button Style="{StaticResource GhostButtonStyle}" Content="MODS + WORKSHOP" Click="GoMods_Click" AutomationProperties.Name="Open mods and Workshop" />
                        </StackPanel>

                        <Grid ColumnSpacing="14" Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource PanelBorderStyle}" Grid.Column="0">
                                <StackPanel Spacing="8">
                                    <TextBlock Style="{StaticResource PanelLabelText}" Text="SESSION" />
                                    <TextBlock Style="{StaticResource BodyMutedText}" Text="Enter a profile that clears denylist junk and keeps anticheat and game processes protected." />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource PanelBorderStyle}" Grid.Column="1">
                                <StackPanel Spacing="8">
                                    <TextBlock Style="{StaticResource PanelLabelText}" Foreground="{StaticResource CobaltAccentBrush}" Text="NETWORK" />
                                    <TextBlock Style="{StaticResource BodyMutedText}" Text="Prefer the game NIC. Park OBS upload on the second adapter so stream bitrate cannot choke ping." />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource PanelBorderStyle}" Grid.Column="2">
                                <StackPanel Spacing="8">
                                    <TextBlock Style="{StaticResource PanelLabelText}" Text="STREAM" />
                                    <TextBlock Style="{StaticResource BodyMutedText}" Text="5110×1400 → center 16:9 → 1080p60 with Lanczos + sharpen. Copy OBS filters in one click." />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <Frame x:Name="ContentFrame" Visibility="Collapsed" />
            </Grid>
        </Grid>
    </Grid>
</Page>
