        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border
            x:Name="ChromeBar"
            Grid.Row="0"
            Padding="28,14,28,12"
            BorderBrush="{StaticResource LineSubtleBrush}"
            BorderThickness="0,0,0,1"
            Background="{StaticResource TelemetryStripBrush}"
            Visibility="Collapsed"
            AutomationProperties.Name="Console chrome">
            <Grid ColumnSpacing="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Grid Width="28" Height="28" AutomationProperties.Name="Unbound Infotech mark">
                        <Border Background="{StaticResource CyanPulseBrush}" CornerRadius="2" />
                        <Border Margin="7" Background="{StaticResource ObsidianBrush}" CornerRadius="1" />
                        <Rectangle Width="6" Height="1" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,2,0" Fill="{StaticResource CircuitAmberBrush}" />
                        <Rectangle Width="1" Height="6" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,2,0" Fill="{StaticResource CircuitAmberBrush}" />
                    </Grid>
                    <StackPanel VerticalAlignment="Center" Spacing="0">
                        <TextBlock
                            Style="{StaticResource BrandDisplayText}"
                            FontSize="18"
                            CharacterSpacing="20"
                            Text="{x:Bind ViewModel.ProductName}"
                            Foreground="{StaticResource CyanPulseBrush}" />
                        <TextBlock Style="{StaticResource MicroLabelText}" Text="SYS" Opacity="0.85" />
                    </StackPanel>
                </StackPanel>

                <StackPanel
                    x:Name="NavRail"
                    Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="4"
                    VerticalAlignment="Center"
                    XYFocusKeyboardNavigation="Enabled"
                    AutomationProperties.Name="Primary navigation">
                    <Button x:Name="HomeNav" Tag="Home" Style="{StaticResource TopNavButtonStyle}" Click="Nav_Click" Background="{StaticResource CyanDimFillBrush}" Foreground="{StaticResource CyanPulseBrush}" AutomationProperties.Name="Home">
                        <Grid>
                            <TextBlock Text="HOME" Margin="0,0,0,4" />
                            <Rectangle x:Name="HomeAccent" Height="2" VerticalAlignment="Bottom" Fill="{StaticResource CyanPulseBrush}" />
                        </Grid>
                    </Button>
                    <Button x:Name="SessionNav" Tag="Session" Style="{StaticResource TopNavButtonStyle}" Click="Nav_Click" AutomationProperties.Name="Session">
                        <Grid>
                            <TextBlock Text="SESSION" Margin="0,0,0,4" />
                            <Rectangle x:Name="SessionAccent" Height="2" VerticalAlignment="Bottom" Fill="{StaticResource CyanPulseBrush}" Opacity="0" />
                        </Grid>
                    </Button>
                    <Button x:Name="NetworkNav" Tag="Network" Style="{StaticResource TopNavButtonStyle}" Click="Nav_Click" AutomationProperties.Name="Network">
                        <Grid>
                            <TextBlock Text="NETWORK" Margin="0,0,0,4" />
                            <Rectangle x:Name="NetworkAccent" Height="2" VerticalAlignment="Bottom" Fill="{StaticResource CyanPulseBrush}" Opacity="0" />
                        </Grid>
                    </Button>
                    <Button x:Name="ToolsNav" Tag="Tools" Style="{StaticResource TopNavButtonStyle}" Click="Nav_Click" AutomationProperties.Name="Tools">
                        <Grid>
                            <TextBlock Text="TOOLS" Margin="0,0,0,4" />
                            <Rectangle x:Name="ToolsAccent" Height="2" VerticalAlignment="Bottom" Fill="{StaticResource CyanPulseBrush}" Opacity="0" />
                        </Grid>
                    </Button>
                    <Button x:Name="FilesNav" Tag="Files" Style="{StaticResource TopNavButtonStyle}" Click="Nav_Click" AutomationProperties.Name="Unbound Files">
                        <Grid>
                            <TextBlock Text="FILES" Margin="0,0,0,4" />
                            <Rectangle x:Name="FilesAccent" Height="2" VerticalAlignment="Bottom" Fill="{StaticResource CyanPulseBrush}" Opacity="0" />
                        </Grid>
                    </Button>
                    <Button x:Name="HardwareNav" Tag="Hardware" Style="{StaticResource TopNavButtonStyle}" Click="Nav_Click" AutomationProperties.Name="Hardware">
                        <Grid>
                            <TextBlock Text="HARDWARE" Margin="0,0,0,4" />
                            <Rectangle x:Name="HardwareAccent" Height="2" VerticalAlignment="Bottom" Fill="{StaticResource CyanPulseBrush}" Opacity="0" />
                        </Grid>
                    </Button>
                    <Button x:Name="ModsNav" Tag="Mods" Style="{StaticResource TopNavButtonStyle}" Click="Nav_Click" AutomationProperties.Name="Mods and Steam Workshop">
                        <Grid>
                            <TextBlock Text="MODS" Margin="0,0,0,4" />
                            <Rectangle x:Name="ModsAccent" Height="2" VerticalAlignment="Bottom" Fill="{StaticResource CyanPulseBrush}" Opacity="0" />
                        </Grid>
                    </Button>
                    <Button x:Name="ProfilesNav" Tag="Profiles" Style="{StaticResource TopNavButtonStyle}" Click="Nav_Click" AutomationProperties.Name="Profiles">
                        <Grid>
                            <TextBlock Text="PROFILES" Margin="0,0,0,4" />
                            <Rectangle x:Name="ProfilesAccent" Height="2" VerticalAlignment="Bottom" Fill="{StaticResource CyanPulseBrush}" Opacity="0" />
                        </Grid>
                    </Button>
                    <Button x:Name="SettingsNav" Tag="Settings" Style="{StaticResource TopNavButtonStyle}" Click="Nav_Click" AutomationProperties.Name="Settings">
                        <Grid>
                            <TextBlock Text="SETTINGS" Margin="0,0,0,4" />
                            <Rectangle x:Name="SettingsAccent" Height="2" VerticalAlignment="Bottom" Fill="{StaticResource CyanPulseBrush}" Opacity="0" />
                        </Grid>
                    </Button>
                    <Button
                        x:Name="OverlayNav"
                        Tag="Overlay"
                        Style="{StaticResource TopNavButtonStyle}"
                        Click="Nav_Click"
                        Visibility="Collapsed"
                        AutomationProperties.Name="Desktop overlay addon">
                        <Grid>
                            <TextBlock Text="OVERLAY" Margin="0,0,0,4" />
                            <Rectangle x:Name="OverlayAccent" Height="2" VerticalAlignment="Bottom" Fill="{StaticResource CyanPulseBrush}" Opacity="0" />
                        </Grid>
                    </Button>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="18" VerticalAlignment="Center" AutomationProperties.Name="Live telemetry">
                    <StackPanel Spacing="0" AutomationProperties.Name="CPU usage">
                        <TextBlock Style="{StaticResource TelemetryLabelText}" Text="CPU" />
                        <TextBlock Style="{StaticResource TelemetryValueText}" Text="{x:Bind ViewModel.CpuUsageText, Mode=OneWay}" />
                    </StackPanel>
                    <StackPanel Spacing="0" AutomationProperties.Name="Memory usage">
                        <TextBlock Style="{StaticResource TelemetryLabelText}" Text="MEM" />
                        <TextBlock Style="{StaticResource TelemetryValueText}" Text="{x:Bind ViewModel.MemoryText, Mode=OneWay}" />
                    </StackPanel>
                    <StackPanel Spacing="0" AutomationProperties.Name="Process count">
                        <TextBlock Style="{StaticResource TelemetryLabelText}" Text="PROC" />
                        <TextBlock Style="{StaticResource TelemetryValueText}" Text="{x:Bind ViewModel.ProcessCount, Mode=OneWay}" />
                    </StackPanel>
                    <StackPanel Spacing="0" AutomationProperties.Name="Denylist suspects">
                        <TextBlock Style="{StaticResource TelemetryLabelText}" Text="HITS" />
                        <TextBlock FontFamily="{StaticResource MonoFontFamily}" FontSize="14" Foreground="{StaticResource AlertAmberBrush}" Text="{x:Bind ViewModel.SuspectCount, Mode=OneWay}" />
                    </StackPanel>
                    <StackPanel Spacing="0" AutomationProperties.Name="Session link">
                        <TextBlock Style="{StaticResource TelemetryLabelText}" Text="LINK" />
                        <TextBlock Style="{StaticResource TelemetryValueText}" Text="{x:Bind ViewModel.SessionStateText, Mode=OneWay}" />
                    </StackPanel>
                    <TextBlock
                        Style="{StaticResource MicroLabelText}"
                        VerticalAlignment="Center"
                        Text="LIVE"
                        Visibility="{x:Bind ViewModel.IsSessionActive, Mode=OneWay}"
                        AutomationProperties.Name="Session live" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.Background>
                <StaticResource ResourceKey="HeroAtmosphereBrush" />
            </Grid.Background>
            <Rectangle
                x:Name="HeroScan"
                IsHitTestVisible="False"
                Fill="{StaticResource HeroScanBrush}"
                Opacity="0.55"
                AutomationProperties.AccessibilityView="Raw" />
            <Rectangle
                x:Name="HeroGrid"
                IsHitTestVisible="False"
                Fill="{StaticResource HeroGridBrush}"
                Opacity="0.7"
                AutomationProperties.AccessibilityView="Raw" />
            <Grid x:Name="HeroTicks" IsHitTestVisible="False">
            <Rectangle
                Width="1"
                Height="36"
                Margin="48,10,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Fill="{StaticResource CyanPulseBrush}"
                Opacity="0.28"
                AutomationProperties.AccessibilityView="Raw" />
            <Rectangle
                Width="88"
                Height="1"
                Margin="48,10,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Fill="{StaticResource CircuitAmberBrush}"
                Opacity="0.45"
                AutomationProperties.AccessibilityView="Raw" />
            </Grid>

            <Grid x:Name="HomeView">
                <views:NavigationCubeView
                    x:Name="HomeCube"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    FaceActivated="OnCubeActivated"
                    FrontChanged="OnCubeFrontChanged"
                    Notice="OnCubeNotice" />
                <StackPanel
                    x:Name="HomeTempsHud"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Margin="28,20,0,0"
                    Spacing="6"
                    IsHitTestVisible="False"
                    Visibility="{x:Bind Hud.TempsStripVisibility, Mode=OneWay}"
                    AutomationProperties.Name="System temperatures">
                    <TextBlock Style="{StaticResource HomeHudKickerText}" Text="THERM" />
                    <StackPanel Orientation="Horizontal" Spacing="14">
                        <StackPanel Spacing="0">
                            <TextBlock Style="{StaticResource HomeHudLabelText}" Text="CPU" />
                            <TextBlock Style="{StaticResource HomeHudValueText}" Text="{x:Bind Hud.CpuTempText, Mode=OneWay}" />
                        </StackPanel>
                        <StackPanel Spacing="0">
                            <TextBlock Style="{StaticResource HomeHudLabelText}" Text="GPU" />
                            <TextBlock Style="{StaticResource HomeHudValueText}" Text="{x:Bind Hud.GpuTempText, Mode=OneWay}" />
                        </StackPanel>
                        <StackPanel Spacing="0" Visibility="{x:Bind Hud.PackageVisibility, Mode=OneWay}">
                            <TextBlock Style="{StaticResource HomeHudLabelText}" Text="PKG" />
                            <TextBlock Style="{StaticResource HomeHudValueText}" Text="{x:Bind Hud.PackageTempText, Mode=OneWay}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
                <StackPanel
                    x:Name="HomeClockHud"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,20,28,0"
                    Spacing="2"
                    IsHitTestVisible="False"
                    Visibility="{x:Bind Hud.ClockStripVisibility, Mode=OneWay}"
                    AutomationProperties.Name="Local time">
                    <TextBlock
                        Style="{StaticResource HomeHudKickerText}"
                        HorizontalAlignment="Right"
                        Text="TIME" />
                    <TextBlock
                        Style="{StaticResource HomeHudClockText}"
                        HorizontalAlignment="Right"
                        Text="{x:Bind Hud.ClockText, Mode=OneWay}" />
                </StackPanel>
                <Button
                    x:Name="HomeProfilesGlyph"
                    Tag="Profiles"
                    Style="{StaticResource HomeGlyphButtonStyle}"
                    Content="PRFL"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Bottom"
                    Margin="28,0,0,28"
                    Click="Nav_Click"
                    AutomationProperties.Name="Profiles"
                    AutomationProperties.HelpText="Open session profiles. Hidden chrome on Home; this glyph is the path." />
                <Button
                    x:Name="HomeSettingsGlyph"
                    Tag="Settings"
                    Style="{StaticResource HomeGlyphButtonStyle}"
                    Content="SET"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="0,0,28,28"
                    Click="Nav_Click"
                    AutomationProperties.Name="Settings"
                    AutomationProperties.HelpText="Open Settings. Hidden chrome on Home; this glyph is the path." />
            </Grid>

            <Frame x:Name="ContentFrame" Visibility="Collapsed" />
        </Grid>
    </Grid>
</Page>
