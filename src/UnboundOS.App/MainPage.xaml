                        </Grid>
                    </Button>
                    <Button x:Name="FilesNav" Tag="Files" Style="{StaticResource TopNavButtonStyle}" Click="Nav_Click" AutomationProperties.Name="Unbound Files">
                        <Grid>
                            <TextBlock Text="FILES" Margin="0,0,0,4" />
                            <Rectangle x:Name="FilesAccent" Height="2" VerticalAlignment="Bottom" Fill="{StaticResource CyanPulseBrush}" Opacity="0" />
                        </Grid>
                    </Button>
                    <Button x:Name="HardwareNav" Tag="Hardware" Style="{StaticResource TopNavButtonStyle}" Click="Nav_Click" AutomationProperties.Name="Hardware">
                        <Grid>
                            <TextBlock Text="HARDWARE" Margin="0,0,0,4" />
                            <Rectangle x:Name="HardwareAccent" Height="2" VerticalAlignment="Bottom" Fill="{StaticResource CyanPulseBrush}" Opacity="0" />
                        </Grid>
                    </Button>
                    <Button x:Name="ModsNav" Tag="Mods" Style="{StaticResource TopNavButtonStyle}" Click="Nav_Click" AutomationProperties.Name="Mods and Steam Workshop">
                        <Grid>
                            <TextBlock Text="MODS" Margin="0,0,0,4" />
                            <Rectangle x:Name="ModsAccent" Height="2" VerticalAlignment="Bottom" Fill="{StaticResource CyanPulseBrush}" Opacity="0" />
                        </Grid>
                    </Button>
                    <Button x:Name="ProfilesNav" Tag="Profiles" Style="{StaticResource TopNavButtonStyle}" Click="Nav_Click" AutomationProperties.Name="Profiles">
                        <Grid>
                            <TextBlock Text="PROFILES" Margin="0,0,0,4" />
                            <Rectangle x:Name="ProfilesAccent" Height="2" VerticalAlignment="Bottom" Fill="{StaticResource CyanPulseBrush}" Opacity="0" />
                        </Grid>
                    </Button>
                    <Button x:Name="SettingsNav" Tag="Settings" Style="{StaticResource TopNavButtonStyle}" Click="Nav_Click" AutomationProperties.Name="Settings">
                        <Grid>
                            <TextBlock Text="SETTINGS" Margin="0,0,0,4" />
                            <Rectangle x:Name="SettingsAccent" Height="2" VerticalAlignment="Bottom" Fill="{StaticResource CyanPulseBrush}" Opacity="0" />
                        </Grid>
                    </Button>
                    <Button
                        x:Name="OverlayNav"
                        Tag="Overlay"
                        Style="{StaticResource TopNavButtonStyle}"
                        Click="Nav_Click"
                        Visibility="Collapsed"
                        AutomationProperties.Name="Desktop overlay addon">
                        <Grid>
                            <TextBlock Text="OVERLAY" Margin="0,0,0,4" />
                            <Rectangle x:Name="OverlayAccent" Height="2" VerticalAlignment="Bottom" Fill="{StaticResource CyanPulseBrush}" Opacity="0" />
                        </Grid>
                    </Button>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="18" VerticalAlignment="Center" AutomationProperties.Name="Live telemetry">
                    <StackPanel Spacing="0" AutomationProperties.Name="CPU usage">
                        <TextBlock Style="{StaticResource TelemetryLabelText}" Text="CPU" />
                        <TextBlock Style="{StaticResource TelemetryValueText}" Text="{x:Bind ViewModel.CpuUsageText, Mode=OneWay}" />
                    </StackPanel>
                    <StackPanel Spacing="0" AutomationProperties.Name="Memory usage">
                        <TextBlock Style="{StaticResource TelemetryLabelText}" Text="MEM" />
                        <TextBlock Style="{StaticResource TelemetryValueText}" Text="{x:Bind ViewModel.MemoryText, Mode=OneWay}" />
                    </StackPanel>
                    <StackPanel Spacing="0" AutomationProperties.Name="Process count">
                        <TextBlock Style="{StaticResource TelemetryLabelText}" Text="PROC" />
                        <TextBlock Style="{StaticResource TelemetryValueText}" Text="{x:Bind ViewModel.ProcessCount, Mode=OneWay}" />
                    </StackPanel>
                    <StackPanel Spacing="0" AutomationProperties.Name="Denylist suspects">
                        <TextBlock Style="{StaticResource TelemetryLabelText}" Text="HITS" />
                        <TextBlock FontFamily="{StaticResource MonoFontFamily}" FontSize="14" Foreground="{StaticResource AlertAmberBrush}" Text="{x:Bind ViewModel.SuspectCount, Mode=OneWay}" />
                    </StackPanel>
                    <StackPanel Spacing="0" AutomationProperties.Name="Session link">
                        <TextBlock Style="{StaticResource TelemetryLabelText}" Text="LINK" />
                        <TextBlock Style="{StaticResource TelemetryValueText}" Text="{x:Bind ViewModel.SessionStateText, Mode=OneWay}" />
                    </StackPanel>
                    <TextBlock
                        Style="{StaticResource MicroLabelText}"
                        VerticalAlignment="Center"
                        Text="LIVE"
                        Visibility="{x:Bind ViewModel.IsSessionActive, Mode=OneWay}"
                        AutomationProperties.Name="Session live" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.Background>
                <StaticResource ResourceKey="HeroAtmosphereBrush" />
            </Grid.Background>
            <Rectangle
                IsHitTestVisible="False"
                Fill="{StaticResource HeroScanBrush}"
                Opacity="0.55"
                AutomationProperties.AccessibilityView="Raw" />
            <Rectangle
                IsHitTestVisible="False"
                Fill="{StaticResource HeroGridBrush}"
                Opacity="0.7"
                AutomationProperties.AccessibilityView="Raw" />
            <Rectangle
                Width="1"
                Height="36"
                Margin="48,10,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Fill="{StaticResource CyanPulseBrush}"
                Opacity="0.28"
                IsHitTestVisible="False"
                AutomationProperties.AccessibilityView="Raw" />
            <Rectangle
                Width="88"
                Height="1"
                Margin="48,10,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Fill="{StaticResource CircuitAmberBrush}"
                Opacity="0.45"
                IsHitTestVisible="False"
                AutomationProperties.AccessibilityView="Raw" />

            <ScrollViewer x:Name="HomeView" Padding="48,36,48,28" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="28">
                    <StackPanel Spacing="8" MaxWidth="920">
                        <TextBlock Style="{StaticResource KickerText}" Text="CONSOLE-STYLE SESSION SHELL" />
                        <TextBlock Style="{StaticResource BrandDisplayText}" FontSize="52" Text="UnboundOS" Foreground="{StaticResource PaperBrush}" />
                        <TextBlock
                            Text="{x:Bind ViewModel.Tagline}"
                            FontSize="22"
                            FontFamily="{StaticResource UiFontSemiboldFamily}"
                            Foreground="{StaticResource CyanPulseBrush}" />
                        <TextBlock
                            Style="{StaticResource BodyMutedText}"
                            MaxWidth="720"
                            Text="From Unbound Infotech Corporation. UnboundOS does not replace Windows — it applies a focused gaming or streaming posture, then restores the desktop when you exit." />
                        <TextBlock
                            FontFamily="{StaticResource UiFontFamily}"
                            FontSize="16"
                            Foreground="{StaticResource PaperBrush}"
                            Text="{x:Bind ViewModel.StatusLine, Mode=OneWay}" />
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Style="{StaticResource TileRowLabelText}" Text="START" />
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" XYFocusKeyboardNavigation="Enabled">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Style="{StaticResource ConsoleHeroTileStyle}" Click="GoSession_Click" AutomationProperties.Name="Start session">
                                    <Grid>
                                        <Border Style="{StaticResource ConsoleTileCardStyle}" Background="{StaticResource TileFieldHeroBrush}" />
                                        <TextBlock
                                            Style="{StaticResource MicroLabelText}"
                                            Margin="16,12"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Top"
                                            Text="SYS" />
                                        <TextBlock Style="{StaticResource TileMonogramText}" FontSize="72" Text="S" />
                                        <StackPanel VerticalAlignment="Bottom" Padding="20,16">
                                            <TextBlock Style="{StaticResource TileCaptionText}" FontSize="22" Text="Session" />
                                            <TextBlock Style="{StaticResource TileMetaText}" Text="ENTER" />
                                        </StackPanel>
                                    </Grid>
                                </Button>
                                <Button Style="{StaticResource ConsoleTileButtonStyle}" Click="GoTools_Click" AutomationProperties.Name="Open tools marketplace">
                                    <Grid>
                                        <Border Style="{StaticResource ConsoleTileCardStyle}" Background="{StaticResource TileFieldBrush}" />
                                        <TextBlock Style="{StaticResource TileMonogramText}" Text="T" />
                                        <StackPanel VerticalAlignment="Bottom" Padding="18,14">
                                            <TextBlock Style="{StaticResource TileCaptionText}" Text="Tools" />
                                            <TextBlock Style="{StaticResource TileMetaText}" Text="KIT" />
                                        </StackPanel>
                                    </Grid>
                                </Button>
                                <Button Style="{StaticResource ConsoleTileButtonStyle}" Click="GoNetwork_Click" AutomationProperties.Name="Open network director">
                                    <Grid>
                                        <Border Style="{StaticResource ConsoleTileCardStyle}" Background="{StaticResource TileFieldAltBrush}" />
                                        <TextBlock Style="{StaticResource TileMonogramText}" Text="N" />
                                        <StackPanel VerticalAlignment="Bottom" Padding="18,14">
                                            <TextBlock Style="{StaticResource TileCaptionText}" Text="Network" />
                                            <TextBlock Style="{StaticResource TileMetaText}" Text="SPLIT" />
                                        </StackPanel>
                                    </Grid>
                                </Button>
                                <Button Style="{StaticResource ConsoleTileButtonStyle}" Click="GoMods_Click" AutomationProperties.Name="Open mods and Workshop">
                                    <Grid>
                                        <Border Style="{StaticResource ConsoleTileCardStyle}" Background="{StaticResource TileFieldBrush}" />
                                        <TextBlock Style="{StaticResource TileMonogramText}" Text="M" />
                                        <StackPanel VerticalAlignment="Bottom" Padding="18,14">
                                            <TextBlock Style="{StaticResource TileCaptionText}" Text="Mods" />
                                            <TextBlock Style="{StaticResource TileMetaText}" Text="OPEN" />
                                        </StackPanel>
                                    </Grid>
                                </Button>
                                <Button Style="{StaticResource ConsoleTileButtonStyle}" Click="GoProfiles_Click" AutomationProperties.Name="Open profiles">
                                    <Grid>
                                        <Border Style="{StaticResource ConsoleTileCardStyle}" Background="{StaticResource TileFieldAltBrush}" />
                                        <TextBlock Style="{StaticResource TileMonogramText}" Text="P" />
                                        <StackPanel VerticalAlignment="Bottom" Padding="18,14">
                                            <TextBlock Style="{StaticResource TileCaptionText}" Text="Profiles" />
                                            <TextBlock Style="{StaticResource TileMetaText}" Text="LIBRARY" />
                                        </StackPanel>
                                    </Grid>
                                </Button>
                                <Button Style="{StaticResource ConsoleTileButtonStyle}" Click="GoSettings_Click" AutomationProperties.Name="Open settings">
                                    <Grid>
                                        <Border Style="{StaticResource ConsoleTileCardStyle}" Background="{StaticResource TileFieldBrush}" />
                                        <TextBlock Style="{StaticResource TileMonogramText}" Text="I" />
                                        <StackPanel VerticalAlignment="Bottom" Padding="18,14">
                                            <TextBlock Style="{StaticResource TileCaptionText}" Text="Settings" />
                                            <TextBlock Style="{StaticResource TileMetaText}" Text="HUB" />
                                        </StackPanel>
                                    </Grid>
                                </Button>
                                <Button Style="{StaticResource ConsoleTileButtonStyle}" Click="GoFiles_Click" AutomationProperties.Name="Open Unbound Files">
                                    <Grid>
                                        <Border Style="{StaticResource ConsoleTileCardStyle}" Background="{StaticResource TileFieldAltBrush}" />
                                        <TextBlock Style="{StaticResource TileMonogramText}" Text="F" />
                                        <StackPanel VerticalAlignment="Bottom" Padding="18,14">
                                            <TextBlock Style="{StaticResource TileCaptionText}" Text="Files" />
                                            <TextBlock Style="{StaticResource TileMetaText}" Text="BROWSE" />
                                        </StackPanel>
                                    </Grid>
                                </Button>
                                <Button Style="{StaticResource ConsoleTileButtonStyle}" Click="GoHardware_Click" AutomationProperties.Name="Open hardware">
                                    <Grid>
                                        <Border Style="{StaticResource ConsoleTileCardStyle}" Background="{StaticResource TileFieldBrush}" />
                                        <TextBlock Style="{StaticResource TileMonogramText}" Text="H" />
                                        <StackPanel VerticalAlignment="Bottom" Padding="18,14">
                                            <TextBlock Style="{StaticResource TileCaptionText}" Text="Hardware" />
                                            <TextBlock Style="{StaticResource TileMetaText}" Text="READ" />
                                        </StackPanel>
                                    </Grid>
                                </Button>
                            </StackPanel>
                        </ScrollViewer>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <Frame x:Name="ContentFrame" Visibility="Collapsed" />
        </Grid>
    </Grid>
</Page>
