<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- UnboundOS — signal lime on ink. No purple, no cream. -->
    <Color x:Key="VoidBlack">#07090D</Color>
    <Color x:Key="InkPanel">#10141C</Color>
    <Color x:Key="InkElevated">#171C27</Color>
    <Color x:Key="SignalLime">#C8F531</Color>
    <Color x:Key="SignalLimeDim">#6F8A1C</Color>
    <Color x:Key="IceTelemetry">#7EC8E3</Color>
    <Color x:Key="WarmPaper">#F2F0E9</Color>
    <Color x:Key="MutedSteel">#8B93A7</Color>
    <Color x:Key="AlertAmber">#FFB020</Color>
    <Color x:Key="FaultRed">#FF5C5C</Color>

    <SolidColorBrush x:Key="VoidBlackBrush" Color="{StaticResource VoidBlack}" />
    <SolidColorBrush x:Key="InkPanelBrush" Color="{StaticResource InkPanel}" />
    <SolidColorBrush x:Key="InkElevatedBrush" Color="{StaticResource InkElevated}" />
    <SolidColorBrush x:Key="SignalLimeBrush" Color="{StaticResource SignalLime}" />
    <SolidColorBrush x:Key="SignalLimeDimBrush" Color="{StaticResource SignalLimeDim}" />
    <SolidColorBrush x:Key="IceTelemetryBrush" Color="{StaticResource IceTelemetry}" />
    <SolidColorBrush x:Key="WarmPaperBrush" Color="{StaticResource WarmPaper}" />
    <SolidColorBrush x:Key="MutedSteelBrush" Color="{StaticResource MutedSteel}" />
    <SolidColorBrush x:Key="AlertAmberBrush" Color="{StaticResource AlertAmber}" />
    <SolidColorBrush x:Key="FaultRedBrush" Color="{StaticResource FaultRed}" />

    <LinearGradientBrush x:Key="HeroAtmosphereBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#07090D" Offset="0" />
        <GradientStop Color="#0E1620" Offset="0.45" />
        <GradientStop Color="#121A14" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="SignalSweepBrush" StartPoint="0,0.5" EndPoint="1,0.5">
        <GradientStop Color="#00C8F531" Offset="0" />
        <GradientStop Color="#C8F531" Offset="0.5" />
        <GradientStop Color="#00C8F531" Offset="1" />
    </LinearGradientBrush>

    <Style x:Key="BrandDisplayText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Bahnschrift" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="CharacterSpacing" Value="80" />
        <Setter Property="Foreground" Value="{StaticResource WarmPaperBrush}" />
    </Style>

    <Style x:Key="SectionTitleText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Bahnschrift" />
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource WarmPaperBrush}" />
    </Style>

    <Style x:Key="BodyMutedText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Text" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource MutedSteelBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="SignalButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource SignalLimeBrush}" />
        <Setter Property="Foreground" Value="{StaticResource VoidBlackBrush}" />
        <Setter Property="FontFamily" Value="Bahnschrift" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="20,12" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style x:Key="GhostButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource WarmPaperBrush}" />
        <Setter Property="FontFamily" Value="Bahnschrift" />
        <Setter Property="Padding" Value="16,10" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="BorderBrush" Value="{StaticResource MutedSteelBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style x:Key="PanelBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource InkPanelBrush}" />
        <Setter Property="BorderBrush" Value="#22FFFFFF" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="20" />
    </Style>
</ResourceDictionary>
