    <Style x:Key="ConsoleTileButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="228" />
        <Setter Property="Height" Value="280" />
        <Setter Property="MinWidth" Value="200" />
        <Setter Property="MinHeight" Value="240" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
        <Setter Property="motion:ConsoleMotion.Role" Value="Tile" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid RenderTransformOrigin="0.5,0.5">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Stroke.BorderBrush" Value="{StaticResource CyanPulseBrush}" />
                                        <Setter Target="Ticks.Opacity" Value="1" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Stroke.BorderBrush" Value="{StaticResource CyanPulseBrush}" />
                                        <Setter Target="Ticks.Opacity" Value="1" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Stroke.Opacity" Value="0.4" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="FocusStates">
                                <VisualState x:Name="Unfocused" />
                                <VisualState x:Name="Focused">
                                    <VisualState.Setters>
                                        <Setter Target="Stroke.BorderBrush" Value="{StaticResource CyanPulseBrush}" />
                                        <Setter Target="Ticks.Opacity" Value="1" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="PointerFocused" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Border
                            x:Name="Stroke"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}">
                            <ContentPresenter
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                Content="{TemplateBinding Content}" />
                        </Border>
                        <Grid
                            x:Name="Ticks"
                            Opacity="0"
                            IsHitTestVisible="False"
                            AutomationProperties.AccessibilityView="Raw">
                            <Rectangle Width="10" Height="1" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="4,4,0,0" Fill="{StaticResource CyanPulseBrush}" />
                            <Rectangle Width="1" Height="10" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="4,4,0,0" Fill="{StaticResource CyanPulseBrush}" />
                            <Rectangle Width="10" Height="1" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,4,0" Fill="{StaticResource CircuitAmberBrush}" />
                            <Rectangle Width="1" Height="10" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,4,0" Fill="{StaticResource CircuitAmberBrush}" />
                            <Rectangle Width="10" Height="1" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="4,0,0,4" Fill="{StaticResource CyanPulseBrush}" />
                            <Rectangle Width="1" Height="10" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="4,0,0,4" Fill="{StaticResource CyanPulseBrush}" />
                            <Rectangle Width="10" Height="1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,4,4" Fill="{StaticResource CyanPulseBrush}" />
                            <Rectangle Width="1" Height="10" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,4,4" Fill="{StaticResource CyanPulseBrush}" />
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

