<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:motion="using:UnboundOS.App.Motion">

    <!--
        UnboundOS — Unbound Infotech brand tokens (unboundinfotech.com).
        Obsidian + cyan pulse + cobalt. Circuit amber is a spare seasoning,
        never a second primary. No signal lime, no generic WinUI purple.
        Motion is compositor-driven (ConsoleMotion) plus a packaged WebGL
        Home cube: volcanic grooved 3/4 rest, springy rotate, arcs on a
        turn, Tetris/greeble open on activate. Instant snap, no arcs, no
        open FX when Settings, Windows animations, or a live session say
        off. Home chrome is cube-only. Focus tiles use a 1px cyan hairline
        and L-ticks (one amber corner). No carnival neon, sheen, or squash.
    -->
    <Color x:Key="Obsidian">#05070A</Color>
    <Color x:Key="SteelPanel">#0B121D</Color>
    <Color x:Key="SteelElevated">#111827</Color>
    <Color x:Key="CardSurface">#090C10</Color>
    <Color x:Key="CyanPulse">#00F0FF</Color>
    <Color x:Key="CyanPulseBright">#5CFAFF</Color>
    <Color x:Key="CyanPulseDeep">#00C2D1</Color>
    <Color x:Key="CobaltAccent">#1E40AF</Color>
    <Color x:Key="Paper">#F8FAFC</Color>
    <Color x:Key="MutedText">#94A3B8</Color>
    <Color x:Key="CircuitAmber">#E4B53C</Color>
    <Color x:Key="AlertAmber">#F59E0B</Color>
    <Color x:Key="FaultRed">#FF5C5C</Color>
    <Color x:Key="CyanDimFill">#1A0A2A32</Color>
    <Color x:Key="LineSubtle">#247B9BB3</Color>
    <Color x:Key="LineStrong">#5900F0FF</Color>

    <!-- Site aliases (hsl 186 100% 50% family + official hex) -->
    <Color x:Key="SystemAccentColor">#00F0FF</Color>
    <Color x:Key="SystemAccentColorLight1">#5CFAFF</Color>
    <Color x:Key="SystemAccentColorLight2">#9EFCFF</Color>
    <Color x:Key="SystemAccentColorLight3">#D6FEFF</Color>
    <Color x:Key="SystemAccentColorDark1">#00C2D1</Color>
    <Color x:Key="SystemAccentColorDark2">#1E40AF</Color>
    <Color x:Key="SystemAccentColorDark3">#0B121D</Color>

    <SolidColorBrush x:Key="ObsidianBrush" Color="{StaticResource Obsidian}" />
    <SolidColorBrush x:Key="SteelPanelBrush" Color="{StaticResource SteelPanel}" />
    <SolidColorBrush x:Key="SteelElevatedBrush" Color="{StaticResource SteelElevated}" />
    <SolidColorBrush x:Key="CardSurfaceBrush" Color="{StaticResource CardSurface}" />
    <SolidColorBrush x:Key="CyanPulseBrush" Color="{StaticResource CyanPulse}" />
    <SolidColorBrush x:Key="CyanPulseBrightBrush" Color="{StaticResource CyanPulseBright}" />
    <SolidColorBrush x:Key="CyanPulseDeepBrush" Color="{StaticResource CyanPulseDeep}" />
    <SolidColorBrush x:Key="CobaltAccentBrush" Color="{StaticResource CobaltAccent}" />
    <SolidColorBrush x:Key="PaperBrush" Color="{StaticResource Paper}" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="{StaticResource MutedText}" />
    <SolidColorBrush x:Key="CircuitAmberBrush" Color="{StaticResource CircuitAmber}" />
    <SolidColorBrush x:Key="AlertAmberBrush" Color="{StaticResource AlertAmber}" />
    <SolidColorBrush x:Key="FaultRedBrush" Color="{StaticResource FaultRed}" />
    <SolidColorBrush x:Key="CyanDimFillBrush" Color="#1400F0FF" />
    <SolidColorBrush x:Key="LineSubtleBrush" Color="{StaticResource LineSubtle}" />
    <SolidColorBrush x:Key="LineStrongBrush" Color="{StaticResource LineStrong}" />
    <SolidColorBrush x:Key="TelemetryStripBrush" Color="#CC05070A" />

    <!-- WinUI chrome — keep ComboBox / ListView / NumberBox on-brand -->
    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="{StaticResource CyanPulse}" />
    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#CC00F0FF" />
    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#9900F0FF" />
    <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="{StaticResource CyanPulse}" />
    <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="{StaticResource SteelPanel}" />
    <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="{StaticResource SteelElevated}" />
    <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="{StaticResource LineSubtle}" />
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="{StaticResource Paper}" />
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="{StaticResource MutedText}" />
    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="{StaticResource CardSurface}" />
    <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="SystemControlForegroundBaseHighBrush" Color="{StaticResource Paper}" />
    <SolidColorBrush x:Key="SystemControlBackgroundChromeMediumLowBrush" Color="{StaticResource SteelPanel}" />
    <SolidColorBrush x:Key="InfoBarInformationalSeverityBackgroundBrush" Color="#241E40AF" />
    <SolidColorBrush x:Key="InfoBarInformationalSeverityIconBackground" Color="{StaticResource CobaltAccent}" />

    <FontFamily x:Key="UiFontFamily">ms-appx:///Assets/Fonts/Inter-Regular.ttf#Inter</FontFamily>
    <FontFamily x:Key="UiFontSemiboldFamily">ms-appx:///Assets/Fonts/Inter-SemiBold.ttf#Inter SemiBold</FontFamily>
    <FontFamily x:Key="DisplayFontFamily">ms-appx:///Assets/Fonts/Inter-Bold.ttf#Inter</FontFamily>
    <FontFamily x:Key="MonoFontFamily">ms-appx:///Assets/Fonts/JetBrainsMono-Regular.ttf#JetBrains Mono</FontFamily>

    <LinearGradientBrush x:Key="HeroAtmosphereBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#05070A" Offset="0" />
        <GradientStop Color="#0B121D" Offset="0.48" />
        <GradientStop Color="#081428" Offset="0.82" />
        <GradientStop Color="#0A0906" Offset="1" />
    </LinearGradientBrush>

    <!-- Barely-there scan / grid. Static. Keep opacity on the host ~0.04–0.06. -->
    <LinearGradientBrush
        x:Key="HeroScanBrush"
        MappingMode="Absolute"
        StartPoint="0,0"
        EndPoint="0,9"
        SpreadMethod="Repeat">
        <GradientStop Color="#10FFFFFF" Offset="0" />
        <GradientStop Color="#00FFFFFF" Offset="0.14" />
        <GradientStop Color="#00FFFFFF" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush
        x:Key="HeroGridBrush"
        MappingMode="Absolute"
        StartPoint="0,0"
        EndPoint="36,0"
        SpreadMethod="Repeat">
        <GradientStop Color="#0A00F0FF" Offset="0" />
        <GradientStop Color="#0000F0FF" Offset="0.05" />
        <GradientStop Color="#0000F0FF" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="TileFieldBrush" StartPoint="0.15,0" EndPoint="1,1">
        <GradientStop Color="#111827" Offset="0" />
        <GradientStop Color="#1E40AF" Offset="0.72" />
        <GradientStop Color="#0B121D" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="TileFieldAltBrush" StartPoint="0,1" EndPoint="1,0">
        <GradientStop Color="#0B121D" Offset="0" />
        <GradientStop Color="#123046" Offset="0.55" />
        <GradientStop Color="#0A1A22" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="TileFieldHeroBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#0B121D" Offset="0" />
        <GradientStop Color="#0C3A40" Offset="0.48" />
        <GradientStop Color="#1E40AF" Offset="0.88" />
        <GradientStop Color="#161208" Offset="1" />
    </LinearGradientBrush>

    <Style x:Key="BrandDisplayText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFontFamily}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="CharacterSpacing" Value="40" />
        <Setter Property="Foreground" Value="{StaticResource PaperBrush}" />
    </Style>

    <Style x:Key="SectionTitleText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFontSemiboldFamily}" />
        <Setter Property="FontSize" Value="36" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource PaperBrush}" />
    </Style>

    <Style x:Key="KickerText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="160" />
        <Setter Property="Foreground" Value="{StaticResource CyanPulseBrush}" />
    </Style>

    <Style x:Key="MicroLabelText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="140" />
        <Setter Property="Foreground" Value="{StaticResource CircuitAmberBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="BodyMutedText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="LineHeight" Value="26" />
    </Style>

    <Style x:Key="TelemetryLabelText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="CharacterSpacing" Value="80" />
        <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
    </Style>

    <Style x:Key="TelemetryValueText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource CyanPulseBrush}" />
    </Style>

    <Style x:Key="HomeHudKickerText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}" />
        <Setter Property="FontSize" Value="9" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="180" />
        <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
        <Setter Property="Opacity" Value="0.72" />
    </Style>

    <Style x:Key="HomeHudLabelText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}" />
        <Setter Property="FontSize" Value="9" />
        <Setter Property="CharacterSpacing" Value="80" />
        <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
        <Setter Property="Opacity" Value="0.7" />
    </Style>

    <Style x:Key="HomeHudValueText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource CyanPulseBrush}" />
        <Setter Property="Opacity" Value="0.82" />
    </Style>

    <Style x:Key="HomeHudClockText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource PaperBrush}" />
        <Setter Property="Opacity" Value="0.78" />
        <Setter Property="CharacterSpacing" Value="40" />
    </Style>

    <Style x:Key="PanelLabelText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="CharacterSpacing" Value="80" />
        <Setter Property="Foreground" Value="{StaticResource CyanPulseBrush}" />
    </Style>

    <Style x:Key="SignalButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource CyanPulseBrush}" />
        <Setter Property="Foreground" Value="{StaticResource ObsidianBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="24,14" />
        <Setter Property="MinHeight" Value="48" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="motion:ConsoleMotion.Role" Value="Signal" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Root.BorderBrush" Value="{StaticResource ObsidianBrush}" />
                                        <Setter Target="Root.BorderThickness" Value="1" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed" />
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Opacity" Value="0.38" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="FocusStates">
                                <VisualState x:Name="Unfocused" />
                                <VisualState x:Name="Focused">
                                    <VisualState.Setters>
                                        <Setter Target="Root.BorderBrush" Value="{StaticResource ObsidianBrush}" />
                                        <Setter Target="Root.BorderThickness" Value="1" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="PointerFocused" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Border
                            x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="Transparent"
                            BorderThickness="0"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Foreground="{TemplateBinding Foreground}" />
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GhostButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource CardSurfaceBrush}" />
        <Setter Property="Foreground" Value="{StaticResource PaperBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="20,14" />
        <Setter Property="MinHeight" Value="48" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="BorderBrush" Value="{StaticResource LineSubtleBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="motion:ConsoleMotion.Role" Value="Ghost" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{StaticResource CyanDimFillBrush}" />
                                        <Setter Target="Root.BorderBrush" Value="{StaticResource CyanPulseBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed" />
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Opacity" Value="0.38" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="FocusStates">
                                <VisualState x:Name="Unfocused" />
                                <VisualState x:Name="Focused">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{StaticResource CyanDimFillBrush}" />
                                        <Setter Target="Root.BorderBrush" Value="{StaticResource CyanPulseBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="PointerFocused" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Border
                            x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="Center"
                                Foreground="{TemplateBinding Foreground}" />
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="NavRailButtonStyle" TargetType="Button" BasedOn="{StaticResource GhostButtonStyle}">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
        <Setter Property="motion:ConsoleMotion.Role" Value="Nav" />
    </Style>

    <Style x:Key="PanelBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SteelPanelBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource LineSubtleBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="18" />
        <Setter Property="Padding" Value="28" />
    </Style>

    <Style x:Key="TileRowLabelText" TargetType="TextBlock" BasedOn="{StaticResource PanelLabelText}">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Margin" Value="4,0,0,8" />
    </Style>

    <Style x:Key="TileMonogramText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFontFamily}" />
        <Setter Property="FontSize" Value="64" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource PaperBrush}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Opacity" Value="0.92" />
    </Style>

    <Style x:Key="TileCaptionText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFontSemiboldFamily}" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="Foreground" Value="{StaticResource PaperBrush}" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="TileMetaText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource CyanPulseBrush}" />
        <Setter Property="CharacterSpacing" Value="40" />
    </Style>

    <ItemsPanelTemplate x:Key="HorizontalTilePanel">
        <ItemsStackPanel Orientation="Horizontal" />
    </ItemsPanelTemplate>

    <Style x:Key="ConsoleListViewStyle" TargetType="ListView">
        <Setter Property="ItemsPanel" Value="{StaticResource HorizontalTilePanel}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.HorizontalScrollMode" Value="Enabled" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollMode" Value="Disabled" />
        <Setter Property="ScrollViewer.IsVerticalRailEnabled" Value="False" />
        <Setter Property="SelectionMode" Value="Single" />
        <Setter Property="IsItemClickEnabled" Value="True" />
        <Setter Property="XYFocusKeyboardNavigation" Value="Enabled" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="4,8" />
    </Style>

    <Style x:Key="ConsoleTileItemStyle" TargetType="ListViewItem">
        <Setter Property="MinWidth" Value="216" />
        <Setter Property="MinHeight" Value="268" />
        <Setter Property="Width" Value="228" />
        <Setter Property="Height" Value="280" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0,16,16,16" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
        <Setter Property="motion:ConsoleMotion.Role" Value="Tile" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListViewItem">
                    <Grid RenderTransformOrigin="0.5,0.5">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Stroke.BorderBrush" Value="{StaticResource CyanPulseBrush}" />
                                        <Setter Target="Ticks.Opacity" Value="1" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Stroke.BorderBrush" Value="{StaticResource CyanPulseBrush}" />
                                        <Setter Target="Ticks.Opacity" Value="1" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Selected">
                                    <VisualState.Setters>
                                        <Setter Target="Stroke.BorderBrush" Value="{StaticResource CyanPulseBrush}" />
                                        <Setter Target="Ticks.Opacity" Value="1" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="SelectedPointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Stroke.BorderBrush" Value="{StaticResource CyanPulseBrush}" />
                                        <Setter Target="Ticks.Opacity" Value="1" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="PointerOverSelected">
                                    <VisualState.Setters>
                                        <Setter Target="Stroke.BorderBrush" Value="{StaticResource CyanPulseBrush}" />
                                        <Setter Target="Ticks.Opacity" Value="1" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="SelectedPressed">
                                    <VisualState.Setters>
                                        <Setter Target="Stroke.BorderBrush" Value="{StaticResource CyanPulseBrush}" />
                                        <Setter Target="Ticks.Opacity" Value="1" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Stroke.Opacity" Value="0.4" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="FocusStates">
                                <VisualState x:Name="Unfocused" />
                                <VisualState x:Name="Focused">
                                    <VisualState.Setters>
                                        <Setter Target="Stroke.BorderBrush" Value="{StaticResource CyanPulseBrush}" />
                                        <Setter Target="Ticks.Opacity" Value="1" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="PointerFocused" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Border
                            x:Name="Stroke"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="1"
                            CornerRadius="10">
                            <ContentPresenter
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}" />
                        </Border>
                        <Grid
                            x:Name="Ticks"
                            Opacity="0"
                            IsHitTestVisible="False"
                            AutomationProperties.AccessibilityView="Raw">
                            <Rectangle Width="10" Height="1" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="4,4,0,0" Fill="{StaticResource CyanPulseBrush}" />
                            <Rectangle Width="1" Height="10" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="4,4,0,0" Fill="{StaticResource CyanPulseBrush}" />
                            <Rectangle Width="10" Height="1" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,4,0" Fill="{StaticResource CircuitAmberBrush}" />
                            <Rectangle Width="1" Height="10" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,4,0" Fill="{StaticResource CircuitAmberBrush}" />
                            <Rectangle Width="10" Height="1" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="4,0,0,4" Fill="{StaticResource CyanPulseBrush}" />
                            <Rectangle Width="1" Height="10" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="4,0,0,4" Fill="{StaticResource CyanPulseBrush}" />
                            <Rectangle Width="10" Height="1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,4,4" Fill="{StaticResource CyanPulseBrush}" />
                            <Rectangle Width="1" Height="10" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,4,4" Fill="{StaticResource CyanPulseBrush}" />
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CompactConsoleTileItemStyle" TargetType="ListViewItem" BasedOn="{StaticResource ConsoleTileItemStyle}">
        <Setter Property="MinWidth" Value="176" />
        <Setter Property="MinHeight" Value="216" />
        <Setter Property="Width" Value="188" />
        <Setter Property="Height" Value="228" />
        <Setter Property="Margin" Value="0,16,16,16" />
    </Style>

    <Style x:Key="ConsoleTileCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource TileFieldBrush}" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
    </Style>

