# Copy this file to the repo root as `.env` and fill in real values.
# NEVER commit `.env`. NEVER paste secrets into chat.

# PlanetScale Postgres (Connect → new password after rotating the leaked one)
DATABASE_HOST=aws-us-east-1-1.pg.psdb.cloud
DATABASE_PORT=5432
DATABASE_NAME=postgres
DATABASE_USERNAME=replace_me
DATABASE_PASSWORD=replace_me

# Stripe Dashboard → Developers → API keys (Secret key starts with sk_)
STRIPE_SECRET_KEY=sk_test_or_live_replace_me

# Stripe Dashboard → Developers → Webhooks → Signing secret (whsec_...)
STRIPE_WEBHOOK_SECRET=whsec_replace_me
