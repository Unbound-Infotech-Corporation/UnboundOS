<?xml version="1.0" encoding="UTF-16"?>
<!--
  WinUnbound image stub: register a daily startup audit.
  This file does not run on Linux CI. Import on the Windows image:

    schtasks /Create /TN "Unbound Infotech\UnboundOS Startup Audit" /XML startup-audit-task.xml

  The shell already audits from Settings. This task is for the 24-hour
  cadence on a sealed image. Replace Command with the installed
  UnboundOS.App.exe path. A later /audit-startup switch can apply the
  allowlist without opening the UI. Do not disable anticheat, GPU vendor
  services, Vortex, OBS, or HardProtect.
-->
<Task version="1.4" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo>
    <Description>UnboundOS daily startup audit (allowlist + report). Does not replace Explorer.</Description>
    <URI>\Unbound Infotech\UnboundOS Startup Audit</URI>
  </RegistrationInfo>
  <Triggers>
    <CalendarTrigger>
      <StartBoundary>2026-01-01T04:30:00</StartBoundary>
      <Enabled>true</Enabled>
      <ScheduleByDay>
        <DaysInterval>1</DaysInterval>
      </ScheduleByDay>
    </CalendarTrigger>
  </Triggers>
  <Principals>
    <Principal id="Author">
      <LogonType>InteractiveToken</LogonType>
      <RunLevel>LeastPrivilege</RunLevel>
    </Principal>
  </Principals>
  <Settings>
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>false</StopIfGoingOnBatteries>
    <StartWhenAvailable>true</StartWhenAvailable>
    <Enabled>true</Enabled>
    <Hidden>true</Hidden>
    <ExecutionTimeLimit>PT15M</ExecutionTimeLimit>
  </Settings>
  <Actions Context="Author">
    <Exec>
      <Command>C:\Program Files\Unbound Infotech Corporation\UnboundOS\UnboundOS.App.exe</Command>
      <Arguments>--audit-startup</Arguments>
    </Exec>
  </Actions>
</Task>
